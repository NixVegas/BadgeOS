     try std.testing.expectEqual(@as(u64, 0), liveReport(&right.collection.report).collections);
 }
+
+// Drive one serial (worker_count<=1) minor exactly like gc_controller.collect's
+// w=1 branch, but sized to `frontier`: reset over it, seed the remembered set,
+// drain, verify the closure (the missed-edge detector), then sweep. Returns
+// freed count. Passing a frontier below a live young child id models the
+// undersized-bitmap bug (Layer 2): the mark silently drops and verify panics.
+fn repro_runMinorSized(heap: *ObjectHeap, tr: *Tracer, frontier: u32) !u64 {
+    try tr.resetMinor(frontier);
+    heap_collector.forEachRemsetSource(heap, RS{ .tr = tr, .heap = heap }, RS.cb);
+    tr.drainMinor(heap);
+    // gc_debug: panics "minor mark not closed" if a live young child is unmarked.
+    heap_collector.verifyMinorClosure(heap, tr.mark_bits);
+    const st = heap_collector.minorCollect(heap, tr.mark_bits);
+    heap_collector.remsetClear(heap);
+    return st.freed;
+}
+const RS = struct {
+    tr: *Tracer,
+    heap: *ObjectHeap,
+    fn cb(self: RS, source: ObjectId) void {
+        self.tr.markRemsetSource(self.heap, source);
+    }
+};
+
+test "gc: old->young closure-upvalue edge survives a minor (write-barrier path)" {
+    const allocator = std.testing.allocator;
+    var heap = try ObjectHeap.init(allocator, 1);
+    defer heap.deinit();
+    heap_collector.enableBudget(&heap, 64 << 20, false);
+
+    // Pre-arming closure with one upvalue slot. It is OLD after arming.
+    const closure_id = try heap.addClosure(0, &.{Value.int(0)});
+    heap_collector.armLazy(&heap);
+    try std.testing.expect(closure_id < heap.collection.track_from);
+
+    // Post-arming YOUNG child, referenced ONLY by mutating the OLD closure's
+    // upvalue slot — exactly what writebackUpvalue does in SOLO mode: the store
+    // into the slot plus the old→young write barrier.
+    const child = try heap.addList(&.{ Value.int(7), Value.int(8) });
+    try std.testing.expect(heap.gcIsYoung(child));
+    {
+        const c = try heap.getClosure(closure_id);
+        @constCast(c.upvalues)[0] = Value.list(child);
+    }
+    heap.gcRecordEdge(closure_id, Value.list(child));
+
+    var tr = Tracer.init(allocator);
+    defer tr.deinit();
+    _ = try repro_runMinorSized(&heap, &tr, heap.gcObjectFrontier());
+    try std.testing.expect(!heap.gcIsYoung(child)); // promoted, not swept
+    const c2 = try heap.getClosure(closure_id);
+    try std.testing.expect(c2.upvalues[0].bits == Value.list(child).bits);
+}
+
+test "gc: object-id frontier bounds every live young id (bitmap sizing)" {
+    // The frontier the GC sizes its mark/old bitmaps to MUST be >= every id it
+    // could hand out, or markObject/gcSetOld silently no-op past the bitmap end
+    // and a live young child is swept from under an old parent (use-after-free,
+    // caught by verifyMinorClosure as "minor mark not closed"). This asserts the
+    // invariant across the whole allocation surface: object store cursor, each
+    // worker's TLAB reserved tail, and every live young slot.
+    const allocator = std.testing.allocator;
+    var heap = try ObjectHeap.init(allocator, 2);
+    defer heap.deinit();
+    heap_collector.enableBudget(&heap, 64 << 20, false);
+
+    const saved = containers.worker_id.state();
+    defer containers.worker_id.set(saved.id, saved.is_worker);
+
+    // Bootstrap allocation on both workers, then arm.
+    containers.worker_id.set(0, saved.is_worker);
+    _ = try heap.addList(&.{Value.int(1)});
+    containers.worker_id.set(1, saved.is_worker);
+    _ = try heap.addList(&.{Value.int(2)});
+    heap_collector.armLazy(&heap);
+
+    // Young allocations on BOTH workers: each refills its own object TLAB from
+    // the shared store, so ids interleave and a worker's TLAB end can sit at
+    // the store cursor.
+    var max_young: u32 = 0;
+    var w: u8 = 0;
+    while (w < 2) : (w += 1) {
+        containers.worker_id.set(w, saved.is_worker);
+        var i: usize = 0;
+        while (i < 5000) : (i += 1) {
+            const id = try heap.addList(&.{ Value.int(@intCast(i)), Value.int(@intCast(w)) });
+            if (id > max_young) max_young = id;
+        }
+    }
+
+    const frontier = heap.gcObjectFrontier();
+    // Every id ever handed out is strictly below the frontier, so a bitmap of
+    // `frontier` bits has room for its mark/old bit.
+    try std.testing.expect(frontier > max_young);
+    try std.testing.expect(frontier >= heap.objects.count());
+    // And every worker's reserved TLAB tail is covered.
+    for (heap.worker_locals) |*l| {
+        if (l.object.end == 0) continue;
+        try std.testing.expect(l.object.end <= frontier);
+    }
+}
