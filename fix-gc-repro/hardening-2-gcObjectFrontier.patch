+    /// The true object-id frontier: one past the highest id that has been (or
+    /// can still be) handed out. `objects.count()` is the FlatStore commit
+    /// cursor, advanced a whole chunk at a time under `write_mu`; individual
+    /// ids are then handed out lock-free from per-worker TLABs *within* an
+    /// already-committed chunk. The cursor therefore covers every reserved
+    /// chunk (hence every handed-out id) — but a TLAB whose reserved tail sits
+    /// exactly at the cursor makes `end == count()`. Taking the max over the
+    /// cursor and every worker's TLAB end yields a frontier that is guaranteed
+    /// `>=` every live id even if a future allocation path lets a TLAB run past
+    /// the observed cursor. GC bitmaps (mark/old) MUST be sized from this, not
+    /// from `count()` alone: a mark/promote of an id beyond the bitmap silently
+    /// no-ops (`testAndSet`/`gcSetOld` bounds-check to false), turning a live
+    /// young child into a swept use-after-free. STW only (reads TLAB state).
+    pub fn gcObjectFrontier(self: *const ObjectHeap) u32 {
+        var frontier = self.objects.count();
+        for (self.worker_locals) |*l| {
+            // A zero-cap TLAB (never refilled, or discarded at arming) has
+            // end == 0 and contributes nothing.
+            if (l.object.end == 0) continue;
+            const tlab_frontier = ObjectStore.globalIdOf(l.object.segment, l.object.end);
+            if (tlab_frontier > frontier) frontier = tlab_frontier;
+        }
+        return frontier;
+    }
+
