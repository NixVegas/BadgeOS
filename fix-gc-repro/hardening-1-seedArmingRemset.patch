+/// Seed the remembered set with the old→young edges that already exist when
+/// the tracking boundary is drawn. Objects below `track_from` are now old; any
+/// they reference at or above it are young. The pre-arming write barrier was a
+/// no-op (nothing was tracked), so these edges are invisible to the first minor
+/// unless recorded here — the young referent is swept out from under a live old
+/// parent (use-after-free; the detector reports it as a "missed edge").
+///
+/// The ONLY mutable old→young edge that can predate tracking is a THUNK that
+/// was RESOLVED before arming: its `payload.result` now names a young value.
+/// (Immutable objects — attrs / lists / closures — capture their references at
+/// birth from same-generation values, and any post-arming mutation of a thunk
+/// slot goes through the live write barrier.) So we scan only for resolved
+/// thunks and record the one direct `result` reference. This deliberately reads
+/// no side-store range, so it never touches a reserved-but-unfilled slot or an
+/// unmapped values segment — walking the full object graph here is both
+/// unnecessary and unsafe at the arming safepoint (a thunk the triggering fiber
+/// is still forcing has an in-flux `target` union).
+///
+/// STW-only (the arming safepoint): the world is stopped and worker 0's
+/// remembered set is the collector's own, matching the shard the mark seeds
+/// from.
+fn seedArmingRemset(heap: *ObjectHeap) void {
+    const boundary = heap.collection.track_from;
+    var id: ObjectId = 0;
+    while (id < boundary) : (id += 1) {
+        // Skip reserved-but-unfilled TLAB tail slots (uninitialized Object
+        // memory), recorded by the preceding `discardObjectTLABs`.
+        if (idInDiscardedTail(heap, id)) continue;
+        const obj = heap.objects.get(id);
+        if (obj.* != .thunk) continue;
+        const t = &obj.thunk;
+        const state: future_mod.FutureState = @enumFromInt(future_mod.stateFieldRaw(t.future.state.load(.acquire)));
+        if (state != .resolved) continue; // only a terminal result is a live value edge
+        const ref = ObjectHeap.gcHeapId(t.payload.result) orelse continue;
+        if (!heap.gcIsYoung(ref)) continue; // old→old / non-heap: no barrier needed
+        heap.worker_locals[0].gc_remset.append(heap.allocator, id) catch
+            @panic("gc arming remembered-set seed exhausted");
+    }
+}
+
+fn idInDiscardedTail(heap: *const ObjectHeap, id: ObjectId) bool {
+    for (heap.discarded_object_tails.items) |r| {
+        if (id >= r[0] and id < r[1]) return true;
+    }
+    return false;
+}
+
