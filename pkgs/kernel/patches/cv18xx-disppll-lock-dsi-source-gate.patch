+
+/*
+ * NixVegas badge: the DSI PHY synthesizer source gate. SG2000 TRM v1.0
+ * (sophgo/sophgo-doc 370d81b, SG200X/TRM/contents/cn/clock/
+ * pll_g2_registers_description.table.rst): 0x840 bit 1 is
+ * reg_dsi_ssc_syn_src_en; bit 0 selects the shared MIPIMPLL synthesizer
+ * reference (0: half, 1: full rate). Firmware's setting stands until a
+ * consumer takes the gate, and no CLK_SET_RATE_PARENT retunes MIPIMPLL.
+ */
+static struct cv1800_clk_regbit dsi_src_gate =
+	CV1800_CLK_BIT(REG_PLL_G2_SSC_SYN_CTRL, 1);
+
+static int dsi_src_enable(struct clk_hw *hw)
+{
+	cv1800_clk_setbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+	return 0;
+}
+
+static void dsi_src_disable(struct clk_hw *hw)
+{
+	cv1800_clk_clearbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+}
+
+static int dsi_src_is_enabled(struct clk_hw *hw)
+{
+	return cv1800_clk_checkbit(hw_to_cv1800_clk_common(hw), &dsi_src_gate);
+}
+
+static unsigned long dsi_src_recalc_rate(struct clk_hw *hw,
+					 unsigned long parent_rate)
+{
+	struct cv1800_clk_common *common = hw_to_cv1800_clk_common(hw);
+
+	return readl(common->base + REG_PLL_G2_SSC_SYN_CTRL) & BIT(0) ?
+	       parent_rate : parent_rate / 2;
+}
+
+static const struct clk_ops cv1800_dsi_src_ops = {
+	.enable = dsi_src_enable,
+	.disable = dsi_src_disable,
+	.is_enabled = dsi_src_is_enabled,
+	.recalc_rate = dsi_src_recalc_rate,
+};
+
+static struct cv1800_clk_common clk_dsi_synth_src =
+	CV1800_CLK_COMMON("clk_dsi_synth_src", clk_mipimpll_parents,
+			  &cv1800_dsi_src_ops,
+			  CLK_GET_RATE_NOCACHE | CLK_IGNORE_UNUSED);
