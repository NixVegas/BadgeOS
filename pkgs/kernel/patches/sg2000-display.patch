+#ifndef DRM_LT8912B_PIPELINE_H
+#define DRM_LT8912B_PIPELINE_H
+struct drm_bridge;
+/* Caller serializes the entire chain and unbind. First error is sticky until
+ * a fully stopped retry; no software status constitutes measured output.
+ */
+struct lt8912b_pipeline {
+	int error;
