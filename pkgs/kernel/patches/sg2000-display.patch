+
+/*
+ * SG2000 TRM v1.0 pll_g2_ssc_syn_ctrl (0x840): bit 1 enables the DSI PHY
+ * synthesizer source from MIPIMPLL; bit 0 selects the shared half (450 MHz)
+ * or full (900 MHz) reference for every G2 synthesizer and is only read here.
+ */
+static struct cv1800_clk_regbit clk_dsi_synth_src_gate =
+	CV1800_CLK_BIT(REG_PLL_G2_SSC_SYN_CTRL, 1);
+
+static int clk_dsi_synth_src_enable(struct clk_hw *hw)
+{
+	cv1800_clk_setbit(hw_to_cv1800_clk_common(hw), &clk_dsi_synth_src_gate);
+	return 0;
+}
+
+static void clk_dsi_synth_src_disable(struct clk_hw *hw)
+{
+	cv1800_clk_clearbit(hw_to_cv1800_clk_common(hw), &clk_dsi_synth_src_gate);
+}
+
+static int clk_dsi_synth_src_is_enabled(struct clk_hw *hw)
+{
+	return cv1800_clk_checkbit(hw_to_cv1800_clk_common(hw), &clk_dsi_synth_src_gate);
+}
+
+static unsigned long clk_dsi_synth_src_recalc_rate(struct clk_hw *hw,
+						   unsigned long parent_rate)
+{
+	struct cv1800_clk_common *common = hw_to_cv1800_clk_common(hw);
+
+	return readl(common->base + REG_PLL_G2_SSC_SYN_CTRL) & BIT(0) ?
+	       parent_rate : parent_rate / 2;
+}
+
+static const struct clk_ops clk_dsi_synth_src_ops = {
+	.enable = clk_dsi_synth_src_enable,
+	.disable = clk_dsi_synth_src_disable,
+	.is_enabled = clk_dsi_synth_src_is_enabled,
+	.recalc_rate = clk_dsi_synth_src_recalc_rate,
+};
+
+/* Firmware's gate state is kept until a consumer takes it; no rate propagation. */
