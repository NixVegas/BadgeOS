+/*
+ * NixVegas badge: a stop writes nothing. RESET_N is an RC power-on reset with
+ * no GPIO here (NixVegas/pcb d97cfc1, kicad/hdmi.kicad_sch: R77/C47) on fixed
+ * 1.8 V rails: the LT8912B keeps every register across stops and SoC reboots,
+ * so a receiver reset written here (main 0x03 = 0x7f) would persist as well.
+ */
+static void lt8912_stop(struct lt8912 *lt)
+{
+	gpiod_set_value_cansleep(lt->gp_reset, 1);
+	lt->is_power_on = false;
+}
+
