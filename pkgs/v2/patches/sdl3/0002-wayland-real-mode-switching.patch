diff --git a/include/SDL3/SDL_hints.h b/include/SDL3/SDL_hints.h
index e7b4f73..0b76cdf 100644
--- a/include/SDL3/SDL_hints.h
+++ b/include/SDL3/SDL_hints.h
@@ -3991,6 +3991,35 @@ extern "C" {
  */
 #define SDL_HINT_VIDEO_WAYLAND_MODE_SCALING "SDL_VIDEO_WAYLAND_MODE_SCALING"
 
+/**
+ * A variable controlling whether exclusive fullscreen modes switch the
+ * output's real mode under Wayland.
+ *
+ * When this hint is enabled and the compositor offers wlr-output-management,
+ * the fullscreen modes of a display are the real modes of its output. An
+ * exclusive fullscreen window then switches the output to its mode instead
+ * of scaling to it, and the output goes back to its previous mode when the
+ * window leaves fullscreen, is minimized or destroyed, or SDL quits. A
+ * process that ends without that, such as one that crashes, leaves the
+ * output in the switched mode.
+ *
+ * As on other platforms with real mode switching, exclusive fullscreen
+ * windows minimize on focus loss by default (see
+ * SDL_HINT_VIDEO_MINIMIZE_ON_FOCUS_LOSS).
+ *
+ * Outputs with fewer than two modes, and compositors without
+ * wlr-output-management, keep emulating fullscreen modes, and so does a
+ * window whose switch the compositor fails or cancels.
+ *
+ * The variable can be set to the following values:
+ *
+ * - "0": Fullscreen modes are emulated. (default)
+ * - "1": Fullscreen modes switch the output's mode where possible.
+ *
+ * This hint should be set before SDL is initialized.
+ */
+#define SDL_HINT_VIDEO_WAYLAND_MODE_SWITCH "SDL_VIDEO_WAYLAND_MODE_SWITCH"
+
 /**
  * A variable controlling whether the libdecor Wayland backend is preferred
  * over native decorations.
