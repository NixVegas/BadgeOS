+static void head_handle_finished(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1)
+{
+    DestroyHead((SDL_WaylandOutputHead *)data);
+}
+
+static void head_handle_make(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1, const char *make)
+{
+    // NOP
+}
+
+static void head_handle_model(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1, const char *model)
+{
+    // NOP
+}
