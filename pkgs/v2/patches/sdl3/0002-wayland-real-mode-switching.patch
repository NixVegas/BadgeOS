+static const struct zwlr_output_head_v1_listener head_listener = {
+    head_handle_name,
+    head_handle_description,
+    head_handle_physical_size,
+    head_handle_mode,
+    head_handle_enabled,
+    head_handle_current_mode,
+    head_handle_position,
+    head_handle_transform,
+    head_handle_scale,
+    head_handle_finished,
+    head_handle_make,          // Version 2
+    head_handle_model,         // Version 2
+    head_handle_serial_number, // Version 2
+    head_handle_adaptive_sync  // Version 4
+};
+
+static void manager_handle_head(void *data, struct zwlr_output_manager_v1 *zwlr_output_manager_v1,
+                                struct zwlr_output_head_v1 *zwlr_output_head_v1)
+{
+    SDL_WaylandOutputManager *manager = (SDL_WaylandOutputManager *)data;
+    SDL_WaylandOutputHead *head = (SDL_WaylandOutputHead *)SDL_calloc(1, sizeof(*head));
+
+    if (!head) {
+        zwlr_output_head_v1_destroy(zwlr_output_head_v1);
+        return;
+    }
+
+    head->head = zwlr_output_head_v1;
+    wl_list_init(&head->modes);
+    wl_list_insert(manager->heads.prev, &head->link);
+    zwlr_output_head_v1_add_listener(zwlr_output_head_v1, &head_listener, head);
+}
+
+static void manager_handle_done(void *data, struct zwlr_output_manager_v1 *zwlr_output_manager_v1, uint32_t serial)
+{
+    SDL_WaylandOutputManager *manager = (SDL_WaylandOutputManager *)data;
+
+    manager->serial = serial;
+}
+
+static void manager_handle_finished(void *data, struct zwlr_output_manager_v1 *zwlr_output_manager_v1)
+{
+    SDL_WaylandOutputManager *manager = (SDL_WaylandOutputManager *)data;
+    SDL_WaylandOutputHead *head, *tmp;
+
+    wl_list_for_each_safe (head, tmp, &manager->heads, link) {
+        DestroyHead(head);
+    }
+    zwlr_output_manager_v1_destroy(manager->manager);
+    manager->manager = NULL;
+}
+
+static const struct zwlr_output_manager_v1_listener manager_listener = {
+    manager_handle_head,
+    manager_handle_done,
+    manager_handle_finished
+};
+
+static void sync_handle_done(void *data, struct wl_callback *callback, uint32_t callback_data)
+{
+    *(bool *)data = true;
+}
+
+static const struct wl_callback_listener sync_listener = {
+    sync_handle_done
+};
+
+// Dispatches the manager's queue until the compositor has handled every earlier request.
+static bool RoundtripOutputManager(SDL_WaylandOutputManager *manager)
+{
+    struct wl_display *display = manager->videodata->display;
+    struct wl_proxy *display_wrapper = WAYLAND_wl_proxy_create_wrapper(display);
+    struct wl_callback *callback;
+    bool done = false;
+
+    if (!display_wrapper) {
+        return false;
+    }
+    WAYLAND_wl_proxy_set_queue(display_wrapper, manager->queue);
+    callback = wl_display_sync((struct wl_display *)display_wrapper);
+    WAYLAND_wl_proxy_wrapper_destroy(display_wrapper);
+    if (!callback) {
+        return false;
+    }
+
+    wl_callback_add_listener(callback, &sync_listener, &done);
+    while (!done) {
+        if (WAYLAND_wl_display_dispatch_queue(display, manager->queue) < 0) {
+            break;
+        }
+    }
+    wl_callback_destroy(callback);
+
+    return done;
+}
+
+static void configuration_handle_succeeded(void *data, struct zwlr_output_configuration_v1 *zwlr_output_configuration_v1)
+{
+    *(Wayland_OutputConfigurationResult *)data = WAYLAND_OUTPUT_CONFIGURATION_SUCCEEDED;
+}
+
+static void configuration_handle_failed(void *data, struct zwlr_output_configuration_v1 *zwlr_output_configuration_v1)
+{
+    *(Wayland_OutputConfigurationResult *)data = WAYLAND_OUTPUT_CONFIGURATION_FAILED;
+}
+
+static void configuration_handle_cancelled(void *data, struct zwlr_output_configuration_v1 *zwlr_output_configuration_v1)
+{
+    *(Wayland_OutputConfigurationResult *)data = WAYLAND_OUTPUT_CONFIGURATION_CANCELLED;
+}
+
+static const struct zwlr_output_configuration_v1_listener configuration_listener = {
+    configuration_handle_succeeded,
+    configuration_handle_failed,
+    configuration_handle_cancelled
+};
+
+/* Sets the mode of the named head, in hardware units, and waits for the
+ * compositor's answer. Nothing else about the outputs changes. The result is
+ * still pending if the connection to the compositor was lost.
+ */
+static Wayland_OutputConfigurationResult ApplyMode(SDL_WaylandOutputManager *manager, const char *name, int width, int height, int refresh)
+{
+    struct wl_display *display = manager->videodata->display;
+    Wayland_OutputConfigurationResult result = WAYLAND_OUTPUT_CONFIGURATION_CANCELLED;
+
+    /* The compositor cancels a configuration made from outdated heads. The
+     * events that outdated it arrive before the cancellation, so a second
+     * attempt starts from current heads.
+     */
+    for (int attempt = 0; attempt < 2 && result == WAYLAND_OUTPUT_CONFIGURATION_CANCELLED; ++attempt) {
+        SDL_WaylandOutputHead *target_head = FindHead(manager, name);
+        SDL_WaylandOutputMode *target_mode = target_head ? FindMode(target_head, width, height, refresh) : NULL;
+        struct zwlr_output_configuration_v1 *config;
+        SDL_WaylandOutputHead *head;
+
+        if (!target_mode) {
+            // The head or the mode went away while the last attempt was cancelled.
+            return WAYLAND_OUTPUT_CONFIGURATION_FAILED;
+        }
+
+        config = zwlr_output_manager_v1_create_configuration(manager->manager, manager->serial);
+        result = WAYLAND_OUTPUT_CONFIGURATION_PENDING;
+        zwlr_output_configuration_v1_add_listener(config, &configuration_listener, &result);
+
+        // A configuration has to name every head. The others keep their current state.
+        wl_list_for_each (head, &manager->heads, link) {
+            if (head == target_head) {
+                struct zwlr_output_configuration_head_v1 *config_head = zwlr_output_configuration_v1_enable_head(config, head->head);
+                zwlr_output_configuration_head_v1_set_mode(config_head, target_mode->mode);
+                zwlr_output_configuration_head_v1_destroy(config_head);
+            } else if (head->enabled) {
+                zwlr_output_configuration_head_v1_destroy(zwlr_output_configuration_v1_enable_head(config, head->head));
+            } else {
+                zwlr_output_configuration_v1_disable_head(config, head->head);
+            }
+        }
+        zwlr_output_configuration_v1_apply(config);
+
+        while (result == WAYLAND_OUTPUT_CONFIGURATION_PENDING) {
+            if (WAYLAND_wl_display_dispatch_queue(display, manager->queue) < 0) {
+                break;
+            }
+        }
+        zwlr_output_configuration_v1_destroy(config);
+    }
+
+    if (result == WAYLAND_OUTPUT_CONFIGURATION_SUCCEEDED) {
+        // The heads' new state follows the result.
+        RoundtripOutputManager(manager);
+    }
+    return result;
+}
+
+void Wayland_InitOutputManagement(SDL_VideoData *data, struct wl_registry *registry, uint32_t id, uint32_t version)
+{
+    SDL_WaylandOutputManager *manager;
+    struct wl_proxy *registry_wrapper;
+
+    if (data->output_manager || !SDL_GetHintBoolean(SDL_HINT_VIDEO_WAYLAND_MODE_SWITCH, false)) {
+        return;
+    }
+
+    manager = (SDL_WaylandOutputManager *)SDL_calloc(1, sizeof(*manager));
+    if (!manager) {
+        return;
+    }
+    manager->videodata = data;
+    wl_list_init(&manager->heads);
+
+    manager->queue = Wayland_DisplayCreateQueue(data->display, "SDL Output Management Queue");
+    if (!manager->queue) {
+        SDL_free(manager);
+        return;
+    }
+    registry_wrapper = WAYLAND_wl_proxy_create_wrapper(registry);
+    if (!registry_wrapper) {
+        WAYLAND_wl_event_queue_destroy(manager->queue);
+        SDL_free(manager);
+        return;
+    }
+    WAYLAND_wl_proxy_set_queue(registry_wrapper, manager->queue);
+    manager->manager = wl_registry_bind((struct wl_registry *)registry_wrapper, id, &zwlr_output_manager_v1_interface,
+                                        SDL_min(version, SDL_WLR_OUTPUT_MANAGER_VERSION));
+    WAYLAND_wl_proxy_wrapper_destroy(registry_wrapper);
+    zwlr_output_manager_v1_add_listener(manager->manager, &manager_listener, manager);
+
+    data->output_manager = manager;
+}
+
+void Wayland_SyncOutputManagement(SDL_VideoData *data)
+{
+    if (data->output_manager) {
+        RoundtripOutputManager(data->output_manager);
+    }
+}
+
+void Wayland_QuitOutputManagement(SDL_VideoData *data)
+{
+    SDL_WaylandOutputManager *manager = data->output_manager;
+    SDL_WaylandOutputHead *head, *tmp;
+
+    if (!manager) {
+        return;
+    }
+
+    wl_list_for_each_safe (head, tmp, &manager->heads, link) {
+        DestroyHead(head);
+    }
+    if (manager->manager) {
+        zwlr_output_manager_v1_stop(manager->manager);
+        zwlr_output_manager_v1_destroy(manager->manager);
+    }
+    WAYLAND_wl_event_queue_destroy(manager->queue);
+    SDL_free(manager);
+    data->output_manager = NULL;
+}
+
+bool Wayland_AddHeadDisplayModes(SDL_DisplayData *dispdata, SDL_VideoDisplay *display)
+{
+    SDL_WaylandOutputManager *manager = dispdata->videodata->output_manager;
+    SDL_WaylandOutputHead *head;
+    SDL_WaylandOutputMode *mode;
+    bool added = false;
+
+    if (!manager) {
+        return false;
+    }
+
+    // Take in what the compositor has sent about the heads so far.
+    WAYLAND_wl_display_dispatch_queue_pending(dispdata->videodata->display, manager->queue);
+
+    head = FindSwitchableHead(manager, dispdata->wl_output_name);
+    if (!head) {
+        return false;
+    }
+
+    wl_list_for_each (mode, &head->modes, link) {
+        SDL_DisplayMode display_mode;
+
+        if (mode->width <= 0 || mode->height <= 0) {
+            continue;
+        }
+
+        // Head modes are in hardware units, display modes are transformed.
+        SDL_zero(display_mode);
+        display_mode.format = SDL_PIXELFORMAT_XRGB8888;
+        if (dispdata->transform & WL_OUTPUT_TRANSFORM_90) {
+            display_mode.w = mode->height;
+            display_mode.h = mode->width;
+        } else {
+            display_mode.w = mode->width;
+            display_mode.h = mode->height;
+        }
+        display_mode.refresh_rate_numerator = mode->refresh;
+        display_mode.refresh_rate_denominator = 1000;
+        SDL_AddFullscreenDisplayMode(display, &display_mode);
+        added = true;
+    }
+
+    return added;
+}
+
+bool Wayland_IsOutputModeSwitched(SDL_DisplayData *dispdata)
+{
+    SDL_WaylandOutputManager *manager = dispdata->videodata->output_manager;
+    SDL_WaylandOutputHead *head;
+
+    if (!dispdata->mode_switch.active) {
+        return false;
+    }
+    if (dispdata->pixel_width != dispdata->mode_switch.width ||
+        dispdata->pixel_height != dispdata->mode_switch.height ||
+        dispdata->refresh != dispdata->mode_switch.refresh) {
+        return true;
+    }
+
+    /* The output reports the mode from before the switch. If the head is in
+     * another mode, this report is older than a later switch; otherwise the
+     * switch is over.
+     */
+    if (manager) {
+        WAYLAND_wl_display_dispatch_queue_pending(dispdata->videodata->display, manager->queue);
+    }
+    head = FindHead(manager, dispdata->wl_output_name);
+    if (head && head->current_mode &&
+        (head->current_mode->width != dispdata->mode_switch.width ||
+         head->current_mode->height != dispdata->mode_switch.height ||
+         head->current_mode->refresh != dispdata->mode_switch.refresh)) {
+        return true;
+    }
+
+    dispdata->mode_switch.active = false;
+    return false;
+}
+
+void Wayland_SetSwitchedDisplayMode(SDL_VideoDisplay *display, const SDL_DisplayMode *reported)
+{
+    const int refresh = GetModeRefresh(reported);
+    const SDL_DisplayMode *closest = NULL;
+
+    for (int i = 0; i < display->num_fullscreen_modes; ++i) {
+        const SDL_DisplayMode *mode = &display->fullscreen_modes[i];
+
+        if (mode->w == reported->w && mode->h == reported->h &&
+            (!closest || SDL_abs(GetModeRefresh(mode) - refresh) < SDL_abs(GetModeRefresh(closest) - refresh))) {
+            closest = mode;
+        }
+    }
+
+    if (closest) {
+        SDL_SetCurrentDisplayMode(display, closest);
+    }
+}
+
+/* Leaves the output's mode alone. The window emulates the requested mode, as
+ * it does without mode switching, and the display's current mode stays.
+ */
+static bool EmulateDisplayMode(SDL_VideoDevice *_this)
+{
+    _this->display_mode_emulated = true;
+    return true;
+}
+
+bool Wayland_SetDisplayMode(SDL_VideoDevice *_this, SDL_VideoDisplay *display, SDL_DisplayMode *mode)
+{
+    SDL_VideoData *viddata = _this->internal;
+    SDL_WaylandOutputManager *manager = viddata->output_manager;
+    SDL_DisplayData *dispdata = display->internal;
+    const bool restore = mode == &display->desktop_mode;
+    SDL_WaylandOutputHead *head;
+    SDL_WaylandOutputMode *target;
+    Wayland_OutputConfigurationResult result;
+    int width, height, refresh;
+    bool first_switch;
+
+    if (restore) {
+        if (!dispdata->mode_switch.active) {
+            return true;
+        }
+
+        // Back to the head's mode from before the first switch.
+        width = dispdata->mode_switch.width;
+        height = dispdata->mode_switch.height;
+        refresh = dispdata->mode_switch.refresh;
+    } else if (dispdata->transform & WL_OUTPUT_TRANSFORM_90) {
+        width = mode->h;
+        height = mode->w;
+        refresh = GetModeRefresh(mode);
+    } else {
+        width = mode->w;
+        height = mode->h;
+        refresh = GetModeRefresh(mode);
+    }
+
+    if (manager && manager->manager) {
+        WAYLAND_wl_display_dispatch_queue_pending(viddata->display, manager->queue);
+    }
+    head = FindSwitchableHead(manager, dispdata->wl_output_name);
+    target = head ? FindMode(head, width, height, refresh) : NULL;
+
+    if (!target) {
+        // Going back has nothing to emulate: the output stays switched.
+        if (restore) {
+            return SDL_SetError("wayland: cannot restore output %s to %dx%d",
+                                dispdata->wl_output_name ? dispdata->wl_output_name : "(unnamed)", width, height);
+        }
+        return EmulateDisplayMode(_this);
+    }
+    if (target == head->current_mode) {
+        return true;
+    }
+
+    first_switch = !dispdata->mode_switch.active;
+    if (first_switch) {
+        // Without a mode to go back to, the output does not switch.
+        if (!head->current_mode) {
+            return EmulateDisplayMode(_this);
+        }
+        dispdata->mode_switch.width = head->current_mode->width;
+        dispdata->mode_switch.height = head->current_mode->height;
+        dispdata->mode_switch.refresh = head->current_mode->refresh;
+        dispdata->mode_switch.active = true;
+    }
+
+    result = ApplyMode(manager, dispdata->wl_output_name, width, height, refresh);
+    if (result == WAYLAND_OUTPUT_CONFIGURATION_SUCCEEDED) {
+        return true;
+    }
+    if (first_switch) {
+        dispdata->mode_switch.active = false;
+    }
+
+    if (result == WAYLAND_OUTPUT_CONFIGURATION_PENDING) {
+        return SDL_SetError("wayland: lost the compositor while setting output %s to %dx%d",
+                            dispdata->wl_output_name, width, height);
+    }
+    if (restore) {
+        return SDL_SetError("wayland: the compositor did not restore output %s to %dx%d",
+                            dispdata->wl_output_name, width, height);
+    }
+
+    // The compositor failed or cancelled the switch: emulate the mode instead.
+    SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "wayland: the compositor did not set output %s to %dx%d, emulating it",
+                 dispdata->wl_output_name, width, height);
+    return EmulateDisplayMode(_this);
+}
+
+#endif // SDL_VIDEO_DRIVER_WAYLAND
