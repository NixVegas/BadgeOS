+typedef struct SDL_WaylandOutputHead SDL_WaylandOutputHead;
+
+typedef struct SDL_WaylandOutputMode
+{
+    struct zwlr_output_mode_v1 *mode;
+    SDL_WaylandOutputHead *head;
+    int width;
+    int height;
+    int refresh; // In mHz, 0 if the mode has no fixed refresh rate.
+    struct wl_list link;
+} SDL_WaylandOutputMode;
+
+struct SDL_WaylandOutputHead
+{
+    struct zwlr_output_head_v1 *head;
+    char *name;
+    bool enabled;
+    SDL_WaylandOutputMode *current_mode;
+    struct wl_list modes;
+    struct wl_list link;
+};
+
+typedef struct SDL_WaylandOutputManager
+{
+    SDL_VideoData *videodata;
+    struct zwlr_output_manager_v1 *manager;
+
+    /* The manager and the objects it creates use a queue of their own, so that a
+     * mode switch can wait for the compositor without dispatching other events.
+     */
+    struct wl_event_queue *queue;
+
+    struct wl_list heads;
+    uint32_t serial;
+} SDL_WaylandOutputManager;
+
+typedef enum
+{
+    WAYLAND_OUTPUT_CONFIGURATION_PENDING,
+    WAYLAND_OUTPUT_CONFIGURATION_SUCCEEDED,
+    WAYLAND_OUTPUT_CONFIGURATION_FAILED,
+    WAYLAND_OUTPUT_CONFIGURATION_CANCELLED
+} Wayland_OutputConfigurationResult;
+
+// The refresh rate of a display mode, in mHz.
+static int GetModeRefresh(const SDL_DisplayMode *mode)
+{
+    if (mode->refresh_rate_numerator > 0 && mode->refresh_rate_denominator > 0) {
+        return (int)(((Sint64)mode->refresh_rate_numerator * 1000) / mode->refresh_rate_denominator);
+    }
+    return (int)SDL_lroundf(mode->refresh_rate * 1000.0f);
+}
+
+static void DestroyMode(SDL_WaylandOutputMode *mode)
+{
+    if (mode->head->current_mode == mode) {
+        mode->head->current_mode = NULL;
+    }
+    wl_list_remove(&mode->link);
+
+    if (zwlr_output_mode_v1_get_version(mode->mode) >= ZWLR_OUTPUT_MODE_V1_RELEASE_SINCE_VERSION) {
+        zwlr_output_mode_v1_release(mode->mode);
+    } else {
+        zwlr_output_mode_v1_destroy(mode->mode);
+    }
+    SDL_free(mode);
+}
+
+static void DestroyHead(SDL_WaylandOutputHead *head)
+{
+    SDL_WaylandOutputMode *mode, *tmp;
+
+    wl_list_for_each_safe (mode, tmp, &head->modes, link) {
+        DestroyMode(mode);
+    }
+    wl_list_remove(&head->link);
+
+    if (zwlr_output_head_v1_get_version(head->head) >= ZWLR_OUTPUT_HEAD_V1_RELEASE_SINCE_VERSION) {
+        zwlr_output_head_v1_release(head->head);
+    } else {
+        zwlr_output_head_v1_destroy(head->head);
+    }
+    SDL_free(head->name);
+    SDL_free(head);
+}
+
+static SDL_WaylandOutputHead *FindHead(SDL_WaylandOutputManager *manager, const char *name)
+{
+    SDL_WaylandOutputHead *head;
+
+    if (manager && manager->manager && name) {
+        wl_list_for_each (head, &manager->heads, link) {
+            if (head->name && SDL_strcmp(head->name, name) == 0) {
+                return head;
+            }
+        }
+    }
+    return NULL;
+}
+
+/* The display's head, if it has modes to switch between. wlroots reports an
+ * output without modes, such as a headless one, with its custom mode as the
+ * only mode. A single mode leaves nothing to switch to, so such a display
+ * keeps the emulated modes.
+ */
+static SDL_WaylandOutputHead *FindSwitchableHead(SDL_WaylandOutputManager *manager, const char *name)
+{
+    SDL_WaylandOutputHead *head = FindHead(manager, name);
+
+    if (head && wl_list_length(&head->modes) >= 2) {
+        return head;
+    }
+    return NULL;
+}
+
+// The head's mode of the given size, in hardware units, with the closest refresh rate.
+static SDL_WaylandOutputMode *FindMode(SDL_WaylandOutputHead *head, int width, int height, int refresh)
+{
+    SDL_WaylandOutputMode *mode, *closest = NULL;
+
+    wl_list_for_each (mode, &head->modes, link) {
+        if (mode->width == width && mode->height == height &&
+            (!closest || SDL_abs(mode->refresh - refresh) < SDL_abs(closest->refresh - refresh))) {
+            closest = mode;
+        }
+    }
+    return closest;
+}
+
+static void mode_handle_size(void *data, struct zwlr_output_mode_v1 *zwlr_output_mode_v1,
+                             int32_t width, int32_t height)
+{
+    SDL_WaylandOutputMode *mode = (SDL_WaylandOutputMode *)data;
+
+    mode->width = width;
+    mode->height = height;
+}
+
+static void mode_handle_refresh(void *data, struct zwlr_output_mode_v1 *zwlr_output_mode_v1, int32_t refresh)
+{
+    SDL_WaylandOutputMode *mode = (SDL_WaylandOutputMode *)data;
+
+    mode->refresh = refresh;
+}
+
+static void mode_handle_preferred(void *data, struct zwlr_output_mode_v1 *zwlr_output_mode_v1)
+{
+    // NOP
+}
+
+static void mode_handle_finished(void *data, struct zwlr_output_mode_v1 *zwlr_output_mode_v1)
+{
+    DestroyMode((SDL_WaylandOutputMode *)data);
+}
+
+static const struct zwlr_output_mode_v1_listener mode_listener = {
+    mode_handle_size,
+    mode_handle_refresh,
+    mode_handle_preferred,
+    mode_handle_finished
+};
+
+static void head_handle_name(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1, const char *name)
+{
+    SDL_WaylandOutputHead *head = (SDL_WaylandOutputHead *)data;
+
+    SDL_free(head->name);
+    head->name = SDL_strdup(name);
+}
+
+static void head_handle_description(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1, const char *description)
+{
+    // NOP
+}
+
+static void head_handle_physical_size(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1,
+                                      int32_t width, int32_t height)
+{
+    // NOP
+}
+
+static void head_handle_mode(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1,
+                             struct zwlr_output_mode_v1 *zwlr_output_mode_v1)
+{
+    SDL_WaylandOutputHead *head = (SDL_WaylandOutputHead *)data;
+    SDL_WaylandOutputMode *mode = (SDL_WaylandOutputMode *)SDL_calloc(1, sizeof(*mode));
+
+    if (!mode) {
+        zwlr_output_mode_v1_destroy(zwlr_output_mode_v1);
+        return;
+    }
+
+    mode->mode = zwlr_output_mode_v1;
+    mode->head = head;
+    wl_list_insert(head->modes.prev, &mode->link);
+    zwlr_output_mode_v1_add_listener(zwlr_output_mode_v1, &mode_listener, mode);
+}
+
+static void head_handle_enabled(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1, int32_t enabled)
+{
+    SDL_WaylandOutputHead *head = (SDL_WaylandOutputHead *)data;
+
+    head->enabled = enabled != 0;
+}
+
+static void head_handle_current_mode(void *data, struct zwlr_output_head_v1 *zwlr_output_head_v1,
+                                     struct zwlr_output_mode_v1 *zwlr_output_mode_v1)
+{
+    SDL_WaylandOutputHead *head = (SDL_WaylandOutputHead *)data;
+
+    head->current_mode = zwlr_output_mode_v1 ? (SDL_WaylandOutputMode *)zwlr_output_mode_v1_get_user_data(zwlr_output_mode_v1) : NULL;
+}
+
