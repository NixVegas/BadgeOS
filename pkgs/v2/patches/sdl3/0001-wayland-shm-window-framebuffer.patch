+static void handle_shm_format(void *data, struct wl_shm *shm, uint32_t format)
+{
+    SDL_VideoData *d = data;
+    Uint32 *formats = SDL_realloc(d->shm_formats, (d->shm_format_count + 1) * sizeof(*formats));
+
+    if (formats) {
+        formats[d->shm_format_count++] = format;
+        d->shm_formats = formats;
+    }
+}
+
+static const struct wl_shm_listener shm_listener = {
+    handle_shm_format
+};
+
+bool Wayland_SHMFormatSupported(SDL_VideoData *data, uint32_t wl_shm_format)
+{
+    for (int i = 0; i < data->shm_format_count; ++i) {
+        if (data->shm_formats[i] == wl_shm_format) {
+            return true;
+        }
+    }
+    return false;
+}
