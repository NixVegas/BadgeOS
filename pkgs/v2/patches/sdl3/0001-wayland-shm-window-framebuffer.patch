+  1. The origin of this software must not be misrepresented; you must not
+     claim that you wrote the original software. If you use this software
+     in a product, an acknowledgment in the product documentation would be
+     appreciated but is not required.
+  2. Altered source versions must be plainly marked as such, and must not be
+     misrepresented as being the original software.
+  3. This notice may not be removed or altered from any source distribution.
+*/
+
+#include "SDL_internal.h"
+
+#ifdef SDL_VIDEO_DRIVER_WAYLAND
+
+#include "../../core/unix/SDL_poll.h"
+#include "SDL_waylandvideo.h"
+#include "SDL_waylandwindow.h"
+#include "SDL_waylandframebuffer.h"
+#include "SDL_waylandshmbuffer.h"
+
+/* The window framebuffer is a set of wl_shm buffers that are committed to the
+ * window's surface in turn. A buffer is never written between its commit and
+ * its wl_buffer.release: if none is free, another is allocated, and only past
+ * the maximum count does an update wait for a release.
+ *
+ * In copy mode (the default), the window surface is memory of its own, and an
+ * update copies it into a free buffer. In no-copy mode, the window surface's
+ * pixels are a buffer; an update commits it and points the surface at the next
+ * free buffer.
+ */
+
+#define WAYLAND_FRAMEBUFFER_MIN_BUFFERS 2
+#define WAYLAND_FRAMEBUFFER_MAX_BUFFERS 4
+
+typedef struct
+{
+    Wayland_SHMPool *shm_pool;
+    struct wl_buffer *wl_buffer;
+    void *pixels;
+
+    // Copy mode: the area where this buffer is older than the window surface.
+    SDL_Rect stale;
+
+    // Committed, and not released by the compositor yet.
+    bool busy;
+} SDL_WaylandFramebufferBuffer;
+
+struct SDL_WaylandFramebuffer
+{
+    struct wl_event_queue *queue;
+    SDL_WaylandFramebufferBuffer buffers[WAYLAND_FRAMEBUFFER_MAX_BUFFERS];
+    int num_buffers;
+
+    int width;
+    int height;
+    int pitch;
+    int bytes_per_pixel;
+    Uint32 shm_format;
+
+    // The window surface's own pixels in copy mode, NULL in no-copy mode.
+    void *surface_pixels;
+};
+
+typedef struct SDL_WaylandFramebuffer SDL_WaylandFramebuffer;
+
+static const struct
+{
+    SDL_PixelFormat format;
+    Uint32 shm_format;
+} framebuffer_formats[] = {
+    // The default; every wl_shm supports it.
+    { SDL_PIXELFORMAT_XRGB8888, WL_SHM_FORMAT_XRGB8888 },
+    // B, G, R in memory.
+    { SDL_PIXELFORMAT_BGR24, WL_SHM_FORMAT_RGB888 },
+    // R, G, B in memory.
+    { SDL_PIXELFORMAT_RGB24, WL_SHM_FORMAT_BGR888 }
+};
+
+static void ChooseFramebufferFormat(SDL_VideoData *viddata, SDL_PixelFormat *format, Uint32 *shm_format)
+{
+    const char *hint = SDL_GetHint(SDL_HINT_VIDEO_WAYLAND_SHM_FORMAT);
+
+    *format = framebuffer_formats[0].format;
+    *shm_format = framebuffer_formats[0].shm_format;
+
+    if (hint && *hint) {
+        for (int i = 0; i < SDL_arraysize(framebuffer_formats); ++i) {
+            if (SDL_strcasecmp(hint, SDL_GetPixelFormatName(framebuffer_formats[i].format)) == 0) {
+                if (Wayland_SHMFormatSupported(viddata, framebuffer_formats[i].shm_format)) {
+                    *format = framebuffer_formats[i].format;
+                    *shm_format = framebuffer_formats[i].shm_format;
+                } else {
+                    SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "wayland: the compositor does not support %s for window framebuffers, using %s",
+                                 hint, SDL_GetPixelFormatName(*format));
+                }
+                return;
+            }
+        }
+        SDL_LogDebug(SDL_LOG_CATEGORY_VIDEO, "wayland: %s is not a window framebuffer format, using %s",
+                     hint, SDL_GetPixelFormatName(*format));
+    }
+}
+
+static int GetFramebufferPitch(int width, int bytes_per_pixel)
+{
+    /* wl_shm takes a 24-bit stride only if it is a multiple of 3, and pixman,
+     * which many compositors render with, only if it is a multiple of 4.
+     */
+    const int align = (bytes_per_pixel == 3) ? 12 : 4;
+
+    return (width * bytes_per_pixel + align - 1) / align * align;
+}
+
+static void framebuffer_buffer_handle_release(void *data, struct wl_buffer *wl_buffer)
+{
+    SDL_WaylandFramebufferBuffer *buffer = (SDL_WaylandFramebufferBuffer *)data;
+
+    buffer->busy = false;
+}
+
+static const struct wl_buffer_listener framebuffer_buffer_listener = {
+    framebuffer_buffer_handle_release
+};
+
+static SDL_WaylandFramebufferBuffer *AllocFramebufferBuffer(SDL_WaylandFramebuffer *fb)
+{
+    SDL_WaylandFramebufferBuffer *buffer = &fb->buffers[fb->num_buffers];
+
+    buffer->shm_pool = Wayland_AllocSHMPool(fb->pitch * fb->height);
+    if (!buffer->shm_pool) {
+        return NULL;
+    }
+
+    buffer->wl_buffer = Wayland_AllocBufferFromPoolWithFormat(buffer->shm_pool, fb->width, fb->height, fb->pitch, fb->shm_format, &buffer->pixels);
+    if (!buffer->wl_buffer) {
+        Wayland_ReleaseSHMPool(buffer->shm_pool);
+        SDL_zerop(buffer);
+        SDL_SetError("Failed to create a wl_buffer for the window framebuffer");
+        return NULL;
+    }
+
+    // Releases are read on a queue of their own, so that waiting for one dispatches nothing else.
+    WAYLAND_wl_proxy_set_queue((struct wl_proxy *)buffer->wl_buffer, fb->queue);
+    wl_buffer_add_listener(buffer->wl_buffer, &framebuffer_buffer_listener, buffer);
+
+    buffer->stale.x = 0;
+    buffer->stale.y = 0;
+    buffer->stale.w = fb->width;
+    buffer->stale.h = fb->height;
+    buffer->busy = false;
+
+    ++fb->num_buffers;
+
+    return buffer;
+}
+
+static SDL_WaylandFramebufferBuffer *FindFreeBuffer(SDL_WaylandFramebuffer *fb)
+{
+    for (int i = 0; i < fb->num_buffers; ++i) {
+        if (!fb->buffers[i].busy) {
+            return &fb->buffers[i];
+        }
+    }
+    return NULL;
+}
+
+static SDL_WaylandFramebufferBuffer *FindBufferForPixels(SDL_WaylandFramebuffer *fb, void *pixels)
+{
+    for (int i = 0; i < fb->num_buffers; ++i) {
+        if (fb->buffers[i].pixels == pixels) {
+            return &fb->buffers[i];
+        }
+    }
+    return NULL;
+}
+
+// Handles the releases that have arrived without blocking.
+static bool ReadFramebufferReleases(struct wl_display *display, struct wl_event_queue *queue)
+{
+    WAYLAND_wl_display_flush(display);
+
+    // This fails while the queue holds events, which are then dispatched instead.
+    if (WAYLAND_wl_display_prepare_read_queue(display, queue) == 0) {
+        // Beyond this point, wl_display_cancel_read() or wl_display_read_events() must be called.
+        if (SDL_IOReady(WAYLAND_wl_display_get_fd(display), SDL_IOR_READ, 0) > 0) {
+            if (WAYLAND_wl_display_read_events(display) < 0) {
+                return SDL_SetError("Failed to read Wayland events");
+            }
+        } else {
+            WAYLAND_wl_display_cancel_read(display);
+        }
+    }
+
+    if (WAYLAND_wl_display_dispatch_queue_pending(display, queue) < 0) {
+        return SDL_SetError("Failed to dispatch Wayland events");
+    }
+    return true;
+}
+
+static SDL_WaylandFramebufferBuffer *GetFreeBuffer(SDL_VideoData *viddata, SDL_WaylandFramebuffer *fb)
+{
+    SDL_WaylandFramebufferBuffer *buffer;
+
+    if (!ReadFramebufferReleases(viddata->display, fb->queue)) {
+        return NULL;
+    }
+
+    buffer = FindFreeBuffer(fb);
+    if (buffer) {
+        return buffer;
+    }
+
+    // Every buffer is held by the compositor: add one, or else wait for a release.
+    if (fb->num_buffers < WAYLAND_FRAMEBUFFER_MAX_BUFFERS) {
+        buffer = AllocFramebufferBuffer(fb);
+        if (buffer) {
+            return buffer;
+        }
+    }
+
+    while (!(buffer = FindFreeBuffer(fb))) {
+        if (WAYLAND_wl_display_dispatch_queue(viddata->display, fb->queue) < 0) {
+            SDL_SetError("Failed to wait for a window framebuffer buffer");
+            return NULL;
+        }
+    }
+    return buffer;
+}
+
+static void CopyFramebufferRect(SDL_WaylandFramebuffer *fb, SDL_WaylandFramebufferBuffer *buffer, const SDL_Rect *rect)
+{
+    const size_t offset = (size_t)rect->y * fb->pitch + (size_t)rect->x * fb->bytes_per_pixel;
+    const Uint8 *src = (const Uint8 *)fb->surface_pixels + offset;
+    Uint8 *dst = (Uint8 *)buffer->pixels + offset;
+
+    if (rect->x == 0 && rect->w == fb->width) {
+        SDL_memcpy(dst, src, (size_t)rect->h * fb->pitch);
+    } else {
+        const size_t length = (size_t)rect->w * fb->bytes_per_pixel;
+
+        for (int y = 0; y < rect->h; ++y) {
+            SDL_memcpy(dst, src, length);
+            src += fb->pitch;
+            dst += fb->pitch;
+        }
+    }
+}
+
+static bool ClipUpdateRect(SDL_WaylandFramebuffer *fb, const SDL_Rect *rect, SDL_Rect *clipped)
+{
+    const SDL_Rect bounds = { 0, 0, fb->width, fb->height };
+
+    return SDL_GetRectIntersection(rect, &bounds, clipped);
+}
+
+// The bounding box of the update rects, within the framebuffer.
+static void GetUpdateArea(SDL_WaylandFramebuffer *fb, const SDL_Rect *rects, int numrects, SDL_Rect *area)
+{
+    SDL_zerop(area);
+
+    for (int i = 0; i < numrects; ++i) {
+        SDL_Rect rect;
+
+        if (ClipUpdateRect(fb, &rects[i], &rect)) {
+            SDL_GetRectUnion(area, &rect, area);
+        }
+    }
+}
+
+// Copy mode: the window surface changed in 'area', which every buffer but 'current' lacks.
+static void MarkBuffersStale(SDL_WaylandFramebuffer *fb, SDL_WaylandFramebufferBuffer *current, const SDL_Rect *area)
+{
+    for (int i = 0; i < fb->num_buffers; ++i) {
+        if (&fb->buffers[i] != current) {
+            SDL_GetRectUnion(&fb->buffers[i].stale, area, &fb->buffers[i].stale);
+        }
+    }
+}
+
+static bool CanCommit(SDL_WindowData *wind)
+{
+    // No buffer goes to a shell surface before its first configure, or while it is hidden.
+    return wind->shell_surface_status == WAYLAND_SHELL_SURFACE_STATUS_SHOWN ||
+           wind->shell_surface_status == WAYLAND_SHELL_SURFACE_STATUS_WAITING_FOR_FRAME;
+}
+
+static void CommitFramebufferBuffer(SDL_WindowData *wind, SDL_WaylandFramebuffer *fb, SDL_WaylandFramebufferBuffer *buffer, const SDL_Rect *rects, int numrects)
+{
+    struct wl_surface *surface = wind->surface;
+
+    wl_surface_attach(surface, buffer->wl_buffer, 0, 0);
+
+    if (wl_surface_get_version(surface) >= WL_SURFACE_DAMAGE_BUFFER_SINCE_VERSION) {
+        for (int i = 0; i < numrects; ++i) {
+            SDL_Rect rect;
+
+            if (ClipUpdateRect(fb, &rects[i], &rect)) {
+                wl_surface_damage_buffer(surface, rect.x, rect.y, rect.w, rect.h);
+            }
+        }
+    } else {
+        wl_surface_damage(surface, 0, 0, SDL_MAX_SINT32, SDL_MAX_SINT32);
+    }
+
+    wl_surface_commit(surface);
+    buffer->busy = true;
+
+    WAYLAND_wl_display_flush(wind->waylandData->display);
+}
+
+bool Wayland_CreateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, SDL_PixelFormat *format, void **pixels, int *pitch)
+{
+    SDL_VideoData *viddata = _this->internal;
+    SDL_WindowData *wind = window->internal;
+    SDL_WaylandFramebuffer *fb;
+    size_t size;
+    int w, h;
+
+    // A resize creates the framebuffer again.
+    Wayland_DestroyWindowFramebuffer(_this, window);
+
+    if (!viddata->shm) {
+        return SDL_SetError("The Wayland compositor has no wl_shm");
+    }
+
+    SDL_GetWindowSizeInPixels(window, &w, &h);
+    if (w <= 0 || h <= 0) {
+        return SDL_SetError("Window has no size");
+    }
+
+    fb = (SDL_WaylandFramebuffer *)SDL_calloc(1, sizeof(*fb));
+    if (!fb) {
+        return false;
+    }
+
+    ChooseFramebufferFormat(viddata, format, &fb->shm_format);
+    fb->width = w;
+    fb->height = h;
+    fb->bytes_per_pixel = SDL_BYTESPERPIXEL(*format);
+    fb->pitch = GetFramebufferPitch(w, fb->bytes_per_pixel);
+    if (!SDL_size_mul_check_overflow((size_t)fb->pitch, (size_t)h, &size) || size > SDL_MAX_SINT32) {
+        SDL_free(fb);
+        return SDL_SetError("Window framebuffer is too large");
+    }
+
+    fb->queue = Wayland_DisplayCreateQueue(viddata->display, "SDL Window Framebuffer Queue");
+    if (!fb->queue) {
+        SDL_free(fb);
+        return SDL_SetError("Failed to create the window framebuffer event queue");
+    }
+    wind->framebuffer = fb;
+
+    for (int i = 0; i < WAYLAND_FRAMEBUFFER_MIN_BUFFERS; ++i) {
+        if (!AllocFramebufferBuffer(fb)) {
+            Wayland_DestroyWindowFramebuffer(_this, window);
+            return false;
+        }
+    }
+
+    if (SDL_GetHintBoolean(SDL_HINT_VIDEO_WAYLAND_FRAMEBUFFER_NO_COPY, false)) {
+        *pixels = fb->buffers[0].pixels;
+    } else {
+        fb->surface_pixels = SDL_calloc(1, size);
+        if (!fb->surface_pixels) {
+            Wayland_DestroyWindowFramebuffer(_this, window);
+            return false;
+        }
+        *pixels = fb->surface_pixels;
+    }
+    *pitch = fb->pitch;
+
+    return true;
+}
+
+bool Wayland_UpdateWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window, const SDL_Rect *rects, int numrects)
+{
+    SDL_VideoData *viddata = _this->internal;
+    SDL_WindowData *wind = window->internal;
+    SDL_WaylandFramebuffer *fb = wind->framebuffer;
+    SDL_WaylandFramebufferBuffer *buffer;
+    SDL_Rect area;
+
+    if (!fb) {
+        return SDL_SetError("Window has no framebuffer");
+    }
+
+    GetUpdateArea(fb, rects, numrects, &area);
+    if (SDL_RectEmpty(&area)) {
+        return true;
+    }
+
+    if (!CanCommit(wind)) {
+        // Nothing can be shown yet; the buffers just fall further behind the window surface.
+        if (fb->surface_pixels) {
+            MarkBuffersStale(fb, NULL, &area);
+        }
+        return true;
+    }
+
+    if (fb->surface_pixels) {
+        buffer = GetFreeBuffer(viddata, fb);
+        if (!buffer) {
+            return false;
+        }
+
+        // Bring the buffer up to date with the window surface.
+        if (SDL_RectEmpty(&buffer->stale)) {
+            for (int i = 0; i < numrects; ++i) {
+                SDL_Rect rect;
+
+                if (ClipUpdateRect(fb, &rects[i], &rect)) {
+                    CopyFramebufferRect(fb, buffer, &rect);
+                }
+            }
+        } else {
+            SDL_Rect rect;
+
+            SDL_GetRectUnion(&buffer->stale, &area, &rect);
+            CopyFramebufferRect(fb, buffer, &rect);
+        }
+        SDL_zero(buffer->stale);
+        MarkBuffersStale(fb, buffer, &area);
+
+        CommitFramebufferBuffer(wind, fb, buffer, rects, numrects);
+    } else {
+        SDL_WaylandFramebufferBuffer *next;
+
+        buffer = FindBufferForPixels(fb, window->surface->pixels);
+        if (!buffer) {
+            return SDL_SetError("The window surface's pixels are not a window framebuffer buffer");
+        }
+
+        CommitFramebufferBuffer(wind, fb, buffer, rects, numrects);
+
+        // The committed buffer is busy now, so the next one is a different buffer.
+        next = GetFreeBuffer(viddata, fb);
+        if (!next) {
+            return false;
+        }
+        window->surface->pixels = next->pixels;
+    }
+
+    return true;
+}
+
+void Wayland_DestroyWindowFramebuffer(SDL_VideoDevice *_this, SDL_Window *window)
+{
+    SDL_WindowData *wind = window->internal;
+    SDL_WaylandFramebuffer *fb = wind ? wind->framebuffer : NULL;
+
+    if (!fb) {
+        return;
+    }
+
+    /* A buffer the compositor still holds may be destroyed as long as its
+     * storage is not written again, and the surface keeps showing it.
+     */
+    for (int i = 0; i < fb->num_buffers; ++i) {
+        wl_buffer_destroy(fb->buffers[i].wl_buffer);
+        Wayland_ReleaseSHMPool(fb->buffers[i].shm_pool);
+    }
+    WAYLAND_wl_event_queue_destroy(fb->queue);
+
+    SDL_free(fb->surface_pixels);
+    SDL_free(fb);
+    wind->framebuffer = NULL;
+}
+
+#endif // SDL_VIDEO_DRIVER_WAYLAND
