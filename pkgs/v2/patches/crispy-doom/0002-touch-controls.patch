diff --git a/src/doom_touch.h b/src/doom_touch.h
new file mode 100644
index 0000000..c88a1b9
--- /dev/null
+++ b/src/doom_touch.h
@@ -0,0 +1,139 @@
+#include "../panel_touch.h"
+
+static struct panel_touch panel_input;
+static boolean panel_touch;
+static const boolean *panel_menu;
+static unsigned panel_keys;
+static boolean panel_fire;
+static int panel_forward, panel_strafe;
+static float panel_turn;
+static Uint32 panel_repeat;
+
+void I_PanelTouchMenu(const boolean *active)
+{
+    panel_menu = active;
+}
+
+static void PanelKey(unsigned index, boolean down)
+{
+    static const SDL_Scancode scans[] = {SDL_SCANCODE_SPACE, SDL_SCANCODE_ESCAPE,
+        SDL_SCANCODE_RETURN, SDL_SCANCODE_UP, SDL_SCANCODE_DOWN, SDL_SCANCODE_LEFT, SDL_SCANCODE_RIGHT};
+    static const SDL_Keycode keys[] = {SDLK_SPACE, SDLK_ESCAPE, SDLK_RETURN,
+        SDLK_UP, SDLK_DOWN, SDLK_LEFT, SDLK_RIGHT};
+    SDL_Event event;
+    SDL_zero(event);
+    event.type = down ? SDL_KEYDOWN : SDL_KEYUP;
+    event.key.state = down ? SDL_PRESSED : SDL_RELEASED;
+    event.key.keysym.scancode = scans[index];
+    event.key.keysym.sym = keys[index];
+    I_HandleKeyboardEvent(&event);
+}
+
+static void PanelKeys(unsigned keys)
+{
+    for (unsigned i = 0; i < 7; i++)
+        if ((keys ^ panel_keys) & (1u << i)) PanelKey(i, (keys & (1u << i)) != 0);
+    if ((keys ^ panel_keys) & 0x78u) panel_repeat = SDL_GetTicks() + 350;
+    panel_keys = keys;
+}
+
+static unsigned PanelMapKeys(struct pt_output o, unsigned buttons, boolean menu)
+{
+    unsigned keys = (buttons & (1u << PT_USE) ? 1u : 0) |
+                    (buttons & (1u << PT_MENU) ? 2u : 0) |
+                    (buttons & (1u << PT_OK) ? 4u : 0);
+    if (menu) {
+        if (buttons & (1u << PT_FIRE)) keys |= 4u;
+        if (o.forward > .35f) keys |= 1u << 3;
+        if (o.forward < -.35f) keys |= 1u << 4;
+        if (o.strafe < -.35f) keys |= 1u << 5;
+        if (o.strafe > .35f) keys |= 1u << 6;
+    }
+    return keys;
+}
+
+static void PanelTouchFrame(void)
+{
+    struct pt_output o = pt_take(&panel_input);
+    boolean menu = panel_menu && *panel_menu;
+    int forward = menu ? 0 : (int)(-o.forward * 65536);
+    int strafe = menu ? 0 : (int)(o.strafe * 65536);
+    if (forward != panel_forward || strafe != panel_strafe) {
+        event_t event = {.type=ev_joystick, .data3=forward, .data4=strafe};
+        D_PostEvent(&event);
+        panel_forward = forward;
+        panel_strafe = strafe;
+    }
+    /* Preserve a quick down/up pair even if both arrive within one game tick. */
+    PanelKeys(PanelMapKeys(o, o.held | o.pressed, menu));
+    PanelKeys(PanelMapKeys(o, o.held, menu));
+    if (menu && (panel_keys & 0x78u) && SDL_TICKS_PASSED(SDL_GetTicks(), panel_repeat)) {
+        for (unsigned i = 3; i < 7; i++) if (panel_keys & (1u << i)) PanelKey(i, true);
+        panel_repeat = SDL_GetTicks() + 150;
+    }
+    boolean fire = !menu && (o.held & (1u << PT_FIRE));
+    if (fire != panel_fire) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = fire ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+        event.button.button = SDL_BUTTON_LEFT;
+        I_HandleMouseEvent(&event);
+        panel_fire = fire;
+    }
+    panel_turn = menu ? 0 : panel_turn + o.look_x;
+    if ((int)panel_turn != 0) {
+        event_t event = {.type=ev_mouse, .data1=fire, .data2=(int)panel_turn};
+        panel_turn -= event.data2;
+        D_PostEvent(&event);
+    }
+    if (o.pressed & (1u << PT_GUN)) {
+        SDL_Event event;
+        SDL_zero(event);
+        event.type = SDL_MOUSEWHEEL;
+        event.wheel.y = 1;
+        I_HandleMouseEvent(&event);
+    }
+}
+
+static void PanelTouchRelease(void)
+{
+    panel_turn = 0;
+    pt_release_all(&panel_input);
+    PanelTouchFrame();
+}
+
+static void PanelTouchEvent(const SDL_TouchFingerEvent *event)
+{
+    pt_event(&panel_input, event->type == SDL_FINGERDOWN ? PT_DOWN :
+             event->type == SDL_FINGERUP ? PT_UP : PT_MOTION,
+             event->fingerId, event->x, event->y);
+    PanelTouchFrame();
+}
+
+static void PanelFill(void *context, int x, int y, int width, int height, unsigned shade)
+{
+    SDL_Renderer *renderer = context;
+    SDL_Rect rect = {x, y, width, height};
+    SDL_SetRenderDrawColor(renderer, shade, shade, shade, 255);
+    SDL_RenderFillRect(renderer, &rect);
+}
+
+static void PanelTouchDraw(SDL_Renderer *renderer)
+{
+    int width, height, logical_width, logical_height;
+    Uint8 r, g, b, a;
+    SDL_BlendMode blend;
+    /* Draw in window pixels: scaled down from the game's logical size, lines drop out. */
+    SDL_RenderGetLogicalSize(renderer, &logical_width, &logical_height);
+    SDL_RenderSetLogicalSize(renderer, 0, 0);
+    SDL_GetRendererOutputSize(renderer, &width, &height);
+    pt_resize(&panel_input, width, height);
+    SDL_GetRenderDrawColor(renderer, &r, &g, &b, &a);
+    SDL_GetRenderDrawBlendMode(renderer, &blend);
+    /* SDL's software blended fills do not support 24-bit window surfaces. */
+    SDL_SetRenderDrawBlendMode(renderer, SDL_BLENDMODE_NONE);
+    pt_draw(&panel_input, PanelFill, renderer, "USE");
+    SDL_SetRenderDrawBlendMode(renderer, blend);
+    SDL_SetRenderDrawColor(renderer, r, g, b, a);
+    SDL_RenderSetLogicalSize(renderer, logical_width, logical_height);
+}
