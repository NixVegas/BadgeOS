arm-neon: a64: add src_8888_0888

Add an AArch64 NEON fast path for SRC from a8r8g8b8 or x8r8g8b8 to
r8g8b8, and from a8b8g8r8 or x8b8g8r8 to b8g8r8. Eight pixels per
block: ld4 deinterleaves them and st3 writes back the three low
channels, so the same code serves both channel orders.

pixman-arm-neon.c is shared with the 32-bit NEON build, whose assembly
has no such function, so the binding and the table entries are built
for AArch64 only.

Signed-off-by: badgeos
---
diff --git a/pixman/pixman-arm-neon.c b/pixman/pixman-arm-neon.c
index 103f1c2..255685c 100644
--- a/pixman/pixman-arm-neon.c
+++ b/pixman/pixman-arm-neon.c
@@ -50,6 +50,10 @@ PIXMAN_ARM_BIND_FAST_PATH_SRC_DST (neon, src_0888_8888_rev,
                                    uint8_t, 3, uint32_t, 1)
 PIXMAN_ARM_BIND_FAST_PATH_SRC_DST (neon, src_0888_0565_rev,
                                    uint8_t, 3, uint16_t, 1)
+#ifdef __aarch64__
+PIXMAN_ARM_BIND_FAST_PATH_SRC_DST (neon, src_8888_0888,
+                                   uint32_t, 1, uint8_t, 3)
+#endif
 PIXMAN_ARM_BIND_FAST_PATH_SRC_DST (neon, src_pixbuf_8888,
                                    uint32_t, 1, uint32_t, 1)
 PIXMAN_ARM_BIND_FAST_PATH_SRC_DST (neon, src_rpixbuf_8888,
@@ -291,6 +295,12 @@ static const pixman_fast_path_t arm_neon_fast_paths[] =
     PIXMAN_STD_FAST_PATH (SRC,  r8g8b8,   null,     r8g8b8,   neon_composite_src_0888_0888),
     PIXMAN_STD_FAST_PATH (SRC,  b8g8r8,   null,     x8r8g8b8, neon_composite_src_0888_8888_rev),
     PIXMAN_STD_FAST_PATH (SRC,  b8g8r8,   null,     r5g6b5,   neon_composite_src_0888_0565_rev),
+#ifdef __aarch64__
+    PIXMAN_STD_FAST_PATH (SRC,  a8r8g8b8, null,     r8g8b8,   neon_composite_src_8888_0888),
+    PIXMAN_STD_FAST_PATH (SRC,  x8r8g8b8, null,     r8g8b8,   neon_composite_src_8888_0888),
+    PIXMAN_STD_FAST_PATH (SRC,  a8b8g8r8, null,     b8g8r8,   neon_composite_src_8888_0888),
+    PIXMAN_STD_FAST_PATH (SRC,  x8b8g8r8, null,     b8g8r8,   neon_composite_src_8888_0888),
+#endif
     PIXMAN_STD_FAST_PATH (SRC,  pixbuf,   pixbuf,   a8r8g8b8, neon_composite_src_pixbuf_8888),
     PIXMAN_STD_FAST_PATH (SRC,  pixbuf,   pixbuf,   a8b8g8r8, neon_composite_src_rpixbuf_8888),
     PIXMAN_STD_FAST_PATH (SRC,  rpixbuf,  rpixbuf,  a8r8g8b8, neon_composite_src_rpixbuf_8888),
diff --git a/pixman/pixman-arma64-neon-asm.S b/pixman/pixman-arma64-neon-asm.S
index 519ff5b..712be4a 100644
--- a/pixman/pixman-arma64-neon-asm.S
+++ b/pixman/pixman-arma64-neon-asm.S
@@ -2549,6 +2549,40 @@ generate_composite_function \
 
 /******************************************************************************/
 
+/*
+ * 32bpp to 24bpp: fetch_src_pixblock deinterleaves eight pixels into
+ * v0-v3 with ld4, and st3 stores v0-v2 back, dropping the top byte.
+ */
+
+.macro pixman_composite_src_8888_0888_process_pixblock_head
+.endm
+
+.macro pixman_composite_src_8888_0888_process_pixblock_tail
+.endm
+
+.macro pixman_composite_src_8888_0888_process_pixblock_tail_head
+    st3     {v0.8b, v1.8b, v2.8b}, [DST_W], #24
+    fetch_src_pixblock
+    cache_preload 8, 8
+.endm
+
+generate_composite_function \
+    pixman_composite_src_8888_0888_asm_neon, 32, 0, 24, \
+    FLAG_DST_WRITEONLY | FLAG_DEINTERLEAVE_32BPP, \
+    8, /* number of pixels, processed in a single block */ \
+    10, /* prefetch distance */ \
+    default_init, \
+    default_cleanup, \
+    pixman_composite_src_8888_0888_process_pixblock_head, \
+    pixman_composite_src_8888_0888_process_pixblock_tail, \
+    pixman_composite_src_8888_0888_process_pixblock_tail_head, \
+    0, /* dst_w_basereg */ \
+    0, /* dst_r_basereg */ \
+    0, /* src_basereg   */ \
+    0  /* mask_basereg  */
+
+/******************************************************************************/
+
 .macro pixman_composite_src_0888_8888_rev_process_pixblock_head
     mov    v31.8b, v2.8b
     mov    v2.8b, v0.8b
