diff --git a/include/render/pixman/nv12.h b/include/render/pixman/nv12.h
new file mode 100644
index 0000000..959ee75
--- /dev/null
+++ b/include/render/pixman/nv12.h
@@ -0,0 +1,44 @@
+#ifndef RENDER_PIXMAN_NV12_H
+#define RENDER_PIXMAN_NV12_H
+
+#include <stdbool.h>
+#include <stddef.h>
+#include <stdint.h>
+
+/**
+ * Convert an NV12 image (a Y plane, then a plane of interleaved U and V at half
+ * resolution in both directions, U first) to XRGB8888, with the BT.601 matrix
+ * and limited-range input (Y 16..235, U and V 16..240). Channels are rounded
+ * and clamped to 0..255, and X is written as 0xff.
+ *
+ * Strides are in bytes; dst_stride must be a multiple of 4. Only the
+ * width x height rectangle of dst is written. With an odd width or height, the
+ * last column or row uses the chroma sample of its 2x2 block.
+ *
+ * On aarch64 this uses NEON, and gives the same bytes as
+ * pixman_nv12_to_xrgb8888_c().
+ */
+void pixman_nv12_to_xrgb8888(const uint8_t *y, size_t y_stride,
+	const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+	int width, int height);
+
+/**
+ * The portable C implementation of pixman_nv12_to_xrgb8888(), and the reference
+ * for its vector one.
+ */
+void pixman_nv12_to_xrgb8888_c(const uint8_t *y, size_t y_stride,
+	const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+	int width, int height);
+
+/**
+ * pixman_nv12_to_xrgb8888() for source planes in uncached memory, such as a
+ * write-combined DMA-BUF mapping, where small loads are slow. Each Y row, and
+ * each UV row once for its two Y rows, is first copied into a cached line
+ * buffer, with 32-byte loads on aarch64. Returns false if the line buffer
+ * cannot be allocated.
+ */
+bool pixman_nv12_to_xrgb8888_staged(const uint8_t *y, size_t y_stride,
+	const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+	int width, int height);
+
+#endif
