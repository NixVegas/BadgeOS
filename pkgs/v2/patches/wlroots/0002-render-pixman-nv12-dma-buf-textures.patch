 #define DMA_BUF_SYNC_RW        (DMA_BUF_SYNC_READ | DMA_BUF_SYNC_WRITE)
+#define DMA_BUF_SYNC_START     (0 << 2)
+#define DMA_BUF_SYNC_END       (1 << 2)
 
 /**
  * Check whether DMA-BUF import/export from/to sync_file is available.
@@ -32,4 +34,14 @@ bool dmabuf_import_sync_file(int dmabuf_fd, uint32_t flags, int sync_file_fd);
  */
 int dmabuf_export_sync_file(int dmabuf_fd, uint32_t flags);
 
+/**
+ * Bracket CPU access to a mapped DMA-BUF with DMA_BUF_IOCTL_SYNC.
+ *
+ * flags is DMA_BUF_SYNC_START or DMA_BUF_SYNC_END, combined with the access:
+ * DMA_BUF_SYNC_READ, DMA_BUF_SYNC_WRITE or both. Starting an access waits for
+ * the buffer's implicit fences. Returns false on error, for instance if the FD
+ * is not a DMA-BUF.
+ */
+bool dmabuf_sync_cpu_access(int dmabuf_fd, uint32_t flags);
