+bool dmabuf_sync_cpu_access(int dmabuf_fd, uint32_t flags) {
+	struct dma_buf_sync data = {
+		.flags = flags,
+	};
+	if (drmIoctl(dmabuf_fd, DMA_BUF_IOCTL_SYNC, &data) != 0) {
+		wlr_log_errno(WLR_ERROR, "drmIoctl(SYNC) failed");
+		return false;
+	}
+	return true;
+}
