diff --git a/render/pixman/nv12.c b/render/pixman/nv12.c
new file mode 100644
index 0000000..7a2dfbd
--- /dev/null
+++ b/render/pixman/nv12.c
@@ -0,0 +1,188 @@
+#include <stdlib.h>
+#include <string.h>
+
+#include "render/pixman/nv12.h"
+
+#if defined(__aarch64__) && defined(__ARM_NEON) && !defined(__AARCH64EB__)
+#include <arm_neon.h>
+#define NV12_NEON 1
+#else
+#define NV12_NEON 0
+#endif
+
+// BT.601 (Kr = 0.299, Kb = 0.114) for limited-range input, in 16.16 fixed
+// point: Y - 16 is scaled by 255 / 219, U - 128 and V - 128 by 255 / 224.
+#define FIX_SHIFT 16
+static const int32_t fix_y = 76309; // 255 / 219
+static const int32_t fix_v_r = 104597; // 2 (1 - Kr) * 255 / 224
+static const int32_t fix_u_g = 25675; // 2 Kb (1 - Kb) / Kg * 255 / 224
+static const int32_t fix_v_g = 53279; // 2 Kr (1 - Kr) / Kg * 255 / 224
+static const int32_t fix_u_b = 132201; // 2 (1 - Kb) * 255 / 224
+
+// Round a 16.16 value to the nearest integer and clamp it to 0..255. Negative
+// values return early, so only non-negative ones are shifted.
+static inline uint32_t to_channel(int32_t v) {
+	if (v <= 0) {
+		return 0;
+	}
+	v = (v + (1 << (FIX_SHIFT - 1))) >> FIX_SHIFT;
+	return v > 255 ? 255 : (uint32_t)v;
+}
+
+static inline uint32_t to_xrgb8888(uint8_t y, int32_t r, int32_t g, int32_t b) {
+	int32_t luma = fix_y * (y - 16);
+	return 0xff000000 | (to_channel(luma + r) << 16) |
+		(to_channel(luma + g) << 8) | to_channel(luma + b);
+}
+
+// Pixels [col, width) of one row; col is even
+static void convert_row_c(const uint8_t *y_row, const uint8_t *uv_row,
+		uint32_t *dst_row, int col, int width) {
+	// One U, V pair per two pixels of the row
+	for (; col < width; col += 2) {
+		int32_t u = uv_row[col] - 128;
+		int32_t v = uv_row[col + 1] - 128;
+		int32_t r = fix_v_r * v;
+		int32_t g = -fix_u_g * u - fix_v_g * v;
+		int32_t b = fix_u_b * u;
+
+		dst_row[col] = to_xrgb8888(y_row[col], r, g, b);
+		if (col + 1 < width) {
+			dst_row[col + 1] = to_xrgb8888(y_row[col + 1], r, g, b);
+		}
+	}
+}
+
+#if NV12_NEON
+// One channel of 4 pixels. vqrshrun_n_s32() rounds as to_channel() does,
+// (v + (1 << 15)) >> 16, and saturates to 0..65535; vqmovn_u16() in
+// channel16_neon() then saturates to 255. Together that is to_channel().
+static inline uint16x4_t channel4_neon(int32x4_t luma, int32x4_t chroma) {
+	return vqrshrun_n_s32(vaddq_s32(luma, chroma), FIX_SHIFT);
+}
+
+// One channel of 16 pixels; c_lo and c_hi hold the chroma term of the 8 U, V
+// pairs, each shared by two pixels
+static inline uint8x16_t channel16_neon(const int32x4_t luma[4],
+		int32x4_t c_lo, int32x4_t c_hi) {
+	uint16x8_t lo = vcombine_u16(
+		channel4_neon(luma[0], vzip1q_s32(c_lo, c_lo)),
+		channel4_neon(luma[1], vzip2q_s32(c_lo, c_lo)));
+	uint16x8_t hi = vcombine_u16(
+		channel4_neon(luma[2], vzip1q_s32(c_hi, c_hi)),
+		channel4_neon(luma[3], vzip2q_s32(c_hi, c_hi)));
+	return vcombine_u8(vqmovn_u16(lo), vqmovn_u16(hi));
+}
+
+// Pixels [0, n) of one row, n the largest multiple of 16 not above width;
+// returns n
+static int convert_row_neon(const uint8_t *y_row, const uint8_t *uv_row,
+		uint32_t *dst_row, int width) {
+	int col = 0;
+	for (; col + 16 <= width; col += 16) {
+		uint8x16_t y8 = vld1q_u8(y_row + col);
+		uint8x8x2_t uv8 = vld2_u8(uv_row + col);
+
+		// Y - 16, U - 128 and V - 128: the wrapped 16-bit differences read
+		// as signed are exact
+		int16x8_t y_lo = vreinterpretq_s16_u16(vsubl_u8(vget_low_u8(y8), vdup_n_u8(16)));
+		int16x8_t y_hi = vreinterpretq_s16_u16(vsubl_high_u8(y8, vdupq_n_u8(16)));
+		int16x8_t u = vreinterpretq_s16_u16(vsubl_u8(uv8.val[0], vdup_n_u8(128)));
+		int16x8_t v = vreinterpretq_s16_u16(vsubl_u8(uv8.val[1], vdup_n_u8(128)));
+
+		int32x4_t luma[4] = {
+			vmulq_n_s32(vmovl_s16(vget_low_s16(y_lo)), fix_y),
+			vmulq_n_s32(vmovl_high_s16(y_lo), fix_y),
+			vmulq_n_s32(vmovl_s16(vget_low_s16(y_hi)), fix_y),
+			vmulq_n_s32(vmovl_high_s16(y_hi), fix_y),
+		};
+		int32x4_t u_lo = vmovl_s16(vget_low_s16(u)), u_hi = vmovl_high_s16(u);
+		int32x4_t v_lo = vmovl_s16(vget_low_s16(v)), v_hi = vmovl_high_s16(v);
+
+		uint8x16x4_t bgrx = {{
+			channel16_neon(luma, vmulq_n_s32(u_lo, fix_u_b),
+				vmulq_n_s32(u_hi, fix_u_b)),
+			channel16_neon(luma,
+				vmlsq_n_s32(vmulq_n_s32(u_lo, -fix_u_g), v_lo, fix_v_g),
+				vmlsq_n_s32(vmulq_n_s32(u_hi, -fix_u_g), v_hi, fix_v_g)),
+			channel16_neon(luma, vmulq_n_s32(v_lo, fix_v_r),
+				vmulq_n_s32(v_hi, fix_v_r)),
+			vdupq_n_u8(0xff),
+		}};
+		// XRGB8888 is B, G, R, X in memory
+		vst4q_u8((uint8_t *)(dst_row + col), bgrx);
+	}
+	return col;
+}
+#endif
+
+void pixman_nv12_to_xrgb8888_c(const uint8_t *y, size_t y_stride,
+		const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+		int width, int height) {
+	for (int row = 0; row < height; row++) {
+		convert_row_c(y + (size_t)row * y_stride,
+			uv + (size_t)(row / 2) * uv_stride,
+			(uint32_t *)((uint8_t *)dst + (size_t)row * dst_stride), 0, width);
+	}
+}
+
+void pixman_nv12_to_xrgb8888(const uint8_t *y, size_t y_stride,
+		const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+		int width, int height) {
+#if NV12_NEON
+	for (int row = 0; row < height; row++) {
+		const uint8_t *y_row = y + (size_t)row * y_stride;
+		const uint8_t *uv_row = uv + (size_t)(row / 2) * uv_stride;
+		uint32_t *dst_row = (uint32_t *)((uint8_t *)dst + (size_t)row * dst_stride);
+		int col = convert_row_neon(y_row, uv_row, dst_row, width);
+		convert_row_c(y_row, uv_row, dst_row, col, width);
+	}
+#else
+	pixman_nv12_to_xrgb8888_c(y, y_stride, uv, uv_stride, dst, dst_stride,
+		width, height);
+#endif
+}
+
+// Copy n bytes out of uncached memory. On the Cortex-A53, 32-byte load pairs
+// (ldp q) read write-combined memory about 1.4 times as fast as memcpy() and
+// twice as fast as single 16-byte loads.
+static void copy_uncached(uint8_t *restrict dst, const uint8_t *restrict src,
+		size_t n) {
+#if NV12_NEON
+	for (; n >= 32; n -= 32, src += 32, dst += 32) {
+		uint8x16_t a = vld1q_u8(src);
+		uint8x16_t b = vld1q_u8(src + 16);
+		vst1q_u8(dst, a);
+		vst1q_u8(dst + 16, b);
+	}
+#endif
+	memcpy(dst, src, n);
+}
+
+bool pixman_nv12_to_xrgb8888_staged(const uint8_t *y, size_t y_stride,
+		const uint8_t *uv, size_t uv_stride, uint32_t *dst, size_t dst_stride,
+		int width, int height) {
+	// Two Y rows, then the UV row they share
+	size_t y_len = (size_t)width;
+	size_t uv_len = ((size_t)width + 1) / 2 * 2;
+	uint8_t *line = malloc(2 * y_len + uv_len);
+	if (line == NULL) {
+		return false;
+	}
+	uint8_t *uv_line = line + 2 * y_len;
+
+	for (int row = 0; row < height; row += 2) {
+		int rows = height - row < 2 ? 1 : 2;
+		for (int i = 0; i < rows; i++) {
+			copy_uncached(line + i * y_len, y + (size_t)(row + i) * y_stride, y_len);
+		}
+		copy_uncached(uv_line, uv + (size_t)(row / 2) * uv_stride, uv_len);
+
+		pixman_nv12_to_xrgb8888(line, y_len, uv_line, 0,
+			(uint32_t *)((uint8_t *)dst + (size_t)row * dst_stride), dst_stride,
+			width, rows);
+	}
+
+	free(line);
+	return true;
+}
