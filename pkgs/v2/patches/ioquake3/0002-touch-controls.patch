diff --git a/code/sdl/panel_touch_input.h b/code/sdl/panel_touch_input.h
new file mode 100644
index 0000000..e44cd60
--- /dev/null
+++ b/code/sdl/panel_touch_input.h
@@ -0,0 +1,71 @@
+#include "../../panel_touch.h"
+
+struct panel_touch in_panel_touch;
+qboolean in_panel_touch_enabled;
+static unsigned panel_keys;
+static int panel_axes[2], panel_repeat;
+static float panel_look_x, panel_look_y;
+
+static void IN_PanelKeys(unsigned keys)
+{
+    static const int codes[] = {K_MOUSE1, K_SPACE, K_ESCAPE, K_MWHEELUP, K_ENTER,
+        K_UPARROW, K_DOWNARROW, K_LEFTARROW, K_RIGHTARROW};
+    for (unsigned i = 0; i < 9; i++)
+        if ((keys ^ panel_keys) & (1u << i))
+            Com_QueueEvent(in_eventTime, SE_KEY, codes[i], (keys & (1u << i)) != 0, 0, NULL);
+    if ((keys ^ panel_keys) & 0x1e0u) panel_repeat = Sys_Milliseconds() + 350;
+    panel_keys = keys;
+}
+
+static void IN_PanelTouchFrame(void)
+{
+    struct pt_output o = pt_take(&in_panel_touch);
+    qboolean menu = Key_GetCatcher() != 0;
+    int axes[] = {menu ? 0 : (int)(o.strafe * 127), menu ? 0 : (int)(-o.forward * 127)};
+    for (unsigned i = 0; i < 2; i++) if (axes[i] != panel_axes[i]) {
+        Com_QueueEvent(in_eventTime, SE_JOYSTICK_AXIS, i, axes[i], 0, NULL);
+        panel_axes[i] = axes[i];
+    }
+    unsigned arrows = 0;
+    if (menu) {
+        if (o.forward > .35f) arrows |= 1u << 5;
+        if (o.forward < -.35f) arrows |= 1u << 6;
+        if (o.strafe < -.35f) arrows |= 1u << 7;
+        if (o.strafe > .35f) arrows |= 1u << 8;
+    }
+    unsigned buttons = o.held & ~(1u << PT_GUN);
+    IN_PanelKeys(buttons | (o.pressed & ~(1u << PT_GUN)) | arrows);
+    IN_PanelKeys(buttons | arrows);
+    if (arrows && Sys_Milliseconds() >= panel_repeat) {
+        static const int codes[] = {K_UPARROW, K_DOWNARROW, K_LEFTARROW, K_RIGHTARROW};
+        for (unsigned i = 0; i < 4; i++) if (arrows & (1u << (i+5)))
+            Com_QueueEvent(in_eventTime, SE_KEY, codes[i], qtrue, 0, NULL);
+        panel_repeat = Sys_Milliseconds() + 150;
+    }
+    if (o.pressed & (1u << PT_GUN)) {
+        Com_QueueEvent(in_eventTime, SE_KEY, K_MWHEELUP, qtrue, 0, NULL);
+        Com_QueueEvent(in_eventTime, SE_KEY, K_MWHEELUP, qfalse, 0, NULL);
+    }
+    panel_look_x += o.look_x;
+    panel_look_y += o.look_y;
+    if ((int)panel_look_x || (int)panel_look_y) {
+        Com_QueueEvent(in_eventTime, SE_MOUSE, (int)panel_look_x, (int)panel_look_y, 0, NULL);
+        panel_look_x -= (int)panel_look_x;
+        panel_look_y -= (int)panel_look_y;
+    }
+}
+
+static void IN_PanelTouchRelease(void)
+{
+    panel_look_x = panel_look_y = 0;
+    pt_release_all(&in_panel_touch);
+    IN_PanelTouchFrame();
+}
+
+static void IN_PanelTouchEvent(const SDL_TouchFingerEvent *event)
+{
+    pt_event(&in_panel_touch, event->type == SDL_FINGERDOWN ? PT_DOWN :
+             event->type == SDL_FINGERUP ? PT_UP : PT_MOTION,
+             event->fingerId, event->x, event->y);
+    IN_PanelTouchFrame();
+}
diff --git a/code/client/panel_touch_draw.h b/code/client/panel_touch_draw.h
new file mode 100644
index 0000000..7dd95e4
--- /dev/null
+++ b/code/client/panel_touch_draw.h
@@ -0,0 +1,21 @@
+#include "../../panel_touch.h"
+
+extern struct panel_touch in_panel_touch;
+extern qboolean in_panel_touch_enabled;
+
+static void SCR_PanelFill(void *context, int x, int y, int width, int height, unsigned shade)
+{
+    float value = shade / 255.0f;
+    vec4_t color = {value, value, value, 1};
+    (void)context;
+    re.SetColor(color);
+    re.DrawStretchPic(x, y, width, height, 0, 0, 0, 0, cls.whiteShader);
+}
+
+static void SCR_DrawPanelTouch(void)
+{
+    if (!in_panel_touch_enabled) return;
+    pt_resize(&in_panel_touch, cls.glconfig.vidWidth, cls.glconfig.vidHeight);
+    pt_draw(&in_panel_touch, SCR_PanelFill, NULL, "JUMP");
+    re.SetColor(NULL);
+}
