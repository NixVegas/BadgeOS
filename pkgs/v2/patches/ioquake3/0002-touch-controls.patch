 				}
 				break;
@@ -1232,6 +1243,7 @@
 		IN_ActivateMouse( cls.glconfig.isFullscreen );
 
 	IN_ProcessEvents( );
+	if (in_panel_touch_enabled) IN_PanelTouchFrame();
 
 	// Set event time for next frame to earliest possible time an event could happen
 	in_eventTime = Sys_Milliseconds( );
@@ -1260,6 +1272,11 @@
 	}
 
