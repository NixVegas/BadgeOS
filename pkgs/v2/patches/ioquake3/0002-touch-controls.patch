+				break;
+
 			case SDL_MOUSEMOTION:
 				if( mouseActive )
 				{
@@ -1163,7 +1171,10 @@
 					case SDL_WINDOWEVENT_MINIMIZED:    Cvar_SetValue( "com_minimized", 1 ); break;
