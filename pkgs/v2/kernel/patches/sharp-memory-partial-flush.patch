 {
-	for (u32 line = 0; line < clip.y2; ++line)
-		buffer[line * pitch] = line + 1;
+	/*
+	 * Compacted addressing. drm_fb_xrgb8888_to_mono() writes source rows
+	 * clip.y1..y2 to the TOP of dst (dst row 0 == source row clip.y1), so
+	 * the address for compacted row i is the physical line of source row
+	 * clip.y1 + i, i.e. (clip.y1 + i + 1). Mainline wrote line+1 counting
+	 * from row 0, which only lines up when clip.y1 == 0 -- for y1 > 0 it
+	 * tagged the compacted data with the wrong line numbers (the partial-
+	 * damage corruption). Emitting exactly (y2 - y1) addresses here also
+	 * lets sharp_memory_update_display() transmit only the dirty band.
+	 */
+	u32 nlines = clip.y2 - clip.y1;
+
+	for (u32 i = 0; i < nlines; ++i)
+		buffer[i * pitch] = clip.y1 + i + 1;
 }
 
