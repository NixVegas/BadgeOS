+static void cv18xx_postinit(struct sdhci_host *host, struct dwcmshc_priv *priv)
+{
+	/* Force a low-speed UHS mode for the wifi SDIO. The mainline cv18xx SDR104/
+	 * SDR50 PHY support is incomplete (tuning timing), so drop those caps after
+	 * setup_host; the card then negotiates SDR25/SDR12 (1.8V, NO tuning), which
+	 * is robust enough to bring the AIC8800 fmac up. Higher modes can come once
+	 * the host SDR104 PHY path is finished. */
+	if (priv->flags & FLAG_CV18XX_SD1)
+		host->mmc->caps &= ~(MMC_CAP_UHS_SDR104 | MMC_CAP_UHS_SDR50 |
+				     MMC_CAP_UHS_DDR50);
 }
 
