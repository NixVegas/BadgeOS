+/* Port of vendor sdhci_cv181x_sd_voltage_switch(): drive the SoC pad rail to
+ * 1.8V so the generic 1.8V switch actually completes on cv18xx. */
+static void cv18xx_sdhci_voltage_switch(struct sdhci_host *host)
+{
+	struct sdhci_pltfm_host *pltfm_host = sdhci_priv(host);
+	struct dwcmshc_priv *priv = sdhci_pltfm_priv(pltfm_host);
+	struct cv18xx_priv *cv = priv->priv;
+	u32 val;
 
-	val =  (FIELD_PREP(CV18XX_PHY_TX_DLY_MSK, 0) |
-		FIELD_PREP(CV18XX_PHY_TX_SRC_MSK, CV18XX_PHY_TX_SRC_INVERT_CLK_TX) |
-		FIELD_PREP(CV18XX_PHY_RX_DLY_MSK, 0) |
-		FIELD_PREP(CV18XX_PHY_RX_SRC_MSK, CV18XX_PHY_RX_SRC_INVERT_RX_CLK));
-	sdhci_writel(host, val, priv->vendor_specific_area1 + CV18XX_SDHCI_PHY_TX_RX_DLY);
+	if (!cv)
+		return;
+
+	writeb(readb(cv->pinmuxbase + CV18XX_SDIO0_PAD_CLK) | CV18XX_SDIO0_CLK_DS,
+	       cv->pinmuxbase + CV18XX_SDIO0_PAD_CLK);
+
+	val = readl(cv->topbase + CV18XX_SD_PWRSW_CTRL) & ~CV18XX_PWRSW_VSEL_MASK;
+	val |= CV18XX_PWRSW_SET_1V8;
+	writel(val, cv->topbase + CV18XX_SD_PWRSW_CTRL);
+
+	usleep_range(1000, 2000);
+}
+
+static int cv18xx_init(struct device *dev, struct sdhci_host *host,
+		       struct dwcmshc_priv *dwc_priv)
+{
+	struct cv18xx_priv *cv;
+
+	cv = devm_kzalloc(dev, sizeof(*cv), GFP_KERNEL);
+	if (!cv)
+		return -ENOMEM;
+	cv->topbase = devm_ioremap(dev, CV18XX_TOP_BASE, SZ_4K);
+	cv->pinmuxbase = devm_ioremap(dev, CV18XX_PINMUX_BASE, SZ_4K);
+	if (!cv->topbase || !cv->pinmuxbase)
+		return -ENOMEM;
+	/* Force the SD1 (SDIO1/wifi) data + CMD pads to bias pull-up. The in-band
+	 * SDIO card interrupt is open-drain on DAT1: without a pull-up the line
+	 * cannot idle high so CARD_INT never latches and the driver must poll. The
+	 * bias bits live in the RTC pinconf block (base 0x05027000) which the
+	 * pinctrl driver claims, so devmem cannot reach them; do it here via a
+	 * non-exclusive ioremap. BIT(2)=pull-up enable, BIT(3)=pull-down enable.
+	 * Offsets: D3=0x58 D2=0x5c D1=0x60 D0=0x64 CMD=0x68 (sg2000 pin table). */
+	{
+		void __iomem *cv_rtc = devm_ioremap(dev, 0x05027000, SZ_4K);
+		if (cv_rtc) {
+			static const u16 cv_pads[] = {0x58, 0x5c, 0x60, 0x64, 0x68};
+			int cv_i; u32 cv_v;
+			for (cv_i = 0; cv_i < 5; cv_i++) {
+				cv_v = readl(cv_rtc + cv_pads[cv_i]);
+				dev_info(dev, "cv18xx sd1 pad[0x%03x]=0x%08x pre\n", cv_pads[cv_i], cv_v);
+				writel((cv_v | BIT(2)) & ~BIT(3), cv_rtc + cv_pads[cv_i]);
+			}
+		}
+	}
+	/* The wifi controller is the SD1/SDIO instance; its reset must set the
+	 * reg_0x200[16] instance-select bit (vendor sdhci_cv181x_sdio_reset). */
+	dwc_priv->priv = cv;
+	if (device_property_read_bool(dev, "sophgo,sdio-inst1")) {
+		dwc_priv->flags |= FLAG_CV18XX_SD1;
+		/* Match the vendor SDIO host EXACTLY. The AIC8800 reports a 3.3V OCR
+		 * window in CMD5, so OCR/VDD stays 3.3V (vmmc). Do NOT force 1.8V
+		 * signalling: FLAG_IO_FIXED_1V8 pinned ocr_avail to 1.8V and the core
+		 * rejected the card ("no support for card's volts", -EINVAL) before it
+		 * ever powered. Instead take the bus to 1.8V PHYSICALLY at the SoC pad
+		 * rail (below) and tell the core NO_1_8_V so it never runs the SD-spec
+		 * CMD11 1.8V UHS switch the AIC8800 does not need. This is the vendor's
+		 * proven-good combination (3.3V OCR + NO_1_8_V + 1.8V pad rail). */
+		host->quirks2 |= SDHCI_QUIRK2_NO_1_8_V;
+		/* With NO_1_8_V the core never calls .voltage_switch, so drive the pad
+		 * rail to 1.8V here at probe (vendor sdhci_cv181x does it in probe +
+		 * set_power; SD_PWRSW_CTRL is a sticky SoC TOP register). */
+		cv18xx_sdhci_voltage_switch(host);
+	}
+	return 0;
+}
