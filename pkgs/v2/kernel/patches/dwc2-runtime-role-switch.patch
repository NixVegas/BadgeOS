+/* ------------------------------------------------------------------ *
+ * NixVegas badge: manual, interrupt-masked host<->device role switch. *
+ * ------------------------------------------------------------------ *
+ *
+ * These live in hcd.c because dwc2_vbus_supply_init/_exit() are static
+ * here and dwc2_switch_role() has to raise/lower USB_VBUS_EN. The switch
+ * mirrors dwc2_conn_id_status_change()'s two branches but is called
+ * synchronously from a sysfs write, with the OTG state machine masked so
+ * the connector-ID interrupt a forced mode change raises never wakes the
+ * worker (which is what flaps on this board's self-referential VBUS).
+ */
+
+/*
+ * Program a FIXED session-valid override in GOTGCTL so the core stops
+ * looking at the (oscillating, self-referential) USB_VBUS_DET and uses
+ * the value we pin: A-valid for host, B-valid for device, VBUS-valid for
+ * both, plus the debounce-filter bypass. This is the decoupling step --
+ * with the override on, VBUS_DET transitions are ignored by the core.
+ */
+static void dwc2_role_set_ovr(struct dwc2_hsotg *hsotg, bool host)
+{
+	u32 gotgctl = dwc2_readl(hsotg, GOTGCTL);
+
+	gotgctl |= GOTGCTL_BVALOEN | GOTGCTL_AVALOEN |
+		   GOTGCTL_VBVALOEN | GOTGCTL_DBNCE_FLTR_BYPASS;
+	gotgctl &= ~(GOTGCTL_BVALOVAL | GOTGCTL_AVALOVAL);
+	gotgctl |= GOTGCTL_VBVALOVAL;
+	if (host)
+		gotgctl |= GOTGCTL_AVALOVAL;
+	else
+		gotgctl |= GOTGCTL_BVALOVAL;
+	dwc2_writel(hsotg, gotgctl, GOTGCTL);
+}
+
+/*
+ * dwc2_core_init() -> dwc2_enable_common_interrupts() runs on every
+ * switch; manual_role already keeps the OTG bits out of GINTMSK, but
+ * clear them here too (belt-and-braces) and ack any latched GOTGINT.
+ */
+static void dwc2_role_mask_otg_irqs(struct dwc2_hsotg *hsotg)
+{
+	u32 gintmsk = dwc2_readl(hsotg, GINTMSK);
+
+	gintmsk &= ~(GINTSTS_CONIDSTSCHNG | GINTSTS_SESSREQINT |
+		     GINTSTS_OTGINT | GINTSTS_DISCONNINT);
+	dwc2_writel(hsotg, gintmsk, GINTMSK);
+	/* Ack any OTG events that slipped in while we were switching. */
+	dwc2_writel(hsotg, 0xffffffff, GOTGINT);
+}
+
+/*
+ * Switch the controller to a FIXED role by hand. host==true -> A-host,
+ * host==false -> B-peripheral. No OTG state machine, no worker, no
+ * usb-role-switch. Must run in process context (it sleeps in
+ * dwc2_force_mode()/dwc2_core_init()); the sysfs store() below provides
+ * that. Serialised by hsotg->init_mutex.
+ *
+ * TODO(verify): dwc2_hcd_start()/dwc2_hcd_stop(),
+ * dwc2_hsotg_core_init_disconnected()/_connect()/dwc2_hsotg_disconnect(),
+ * dwc2_enable_acg(), dwc2_core_init(), dwc2_enable_global_interrupts() and
+ * dwc2_force_mode() are exactly the calls dwc2_conn_id_status_change()
+ * makes today; confirm signatures against 7.2.4.
+ */
+int dwc2_switch_role(struct dwc2_hsotg *hsotg, bool host)
+{
+	unsigned long flags;
+
+	if (!hsotg->manual_role) {
+		dev_warn(hsotg->dev,
+			 "dwc2_role: manual switch not enabled (need snps,manual-role-switch)\n");
+		return -EPERM;
+	}
+
+	mutex_lock(&hsotg->init_mutex);
+
+	if (host && dwc2_is_host_mode(hsotg))
+		goto out;			/* already host */
+	if (!host && dwc2_is_device_mode(hsotg))
+		goto out;			/* already device */
+
+	dev_info(hsotg->dev, "dwc2_role: switching to %s\n",
+		 host ? "host" : "device");
+
+	/* Pin the session-valid override, then force the fixed mode. With the
+	 * OTG IRQs masked (manual_role) the CONIDSTSCHNG this raises is inert. */
+	spin_lock_irqsave(&hsotg->lock, flags);
+	dwc2_role_set_ovr(hsotg, host);
+	spin_unlock_irqrestore(&hsotg->lock, flags);
+
+	dwc2_force_mode(hsotg, host);		/* GUSBCFG ForceHst/DevMode + settle wait */
+
+	if (host) {
+		/* Detach the gadget before we become the host. */
+		spin_lock_irqsave(&hsotg->lock, flags);
+		dwc2_hsotg_disconnect(hsotg);
+		spin_unlock_irqrestore(&hsotg->lock, flags);
+
+		hsotg->op_state = OTG_STATE_A_HOST;
+		dwc2_core_init(hsotg, false);
+		dwc2_enable_global_interrupts(hsotg);
+		dwc2_role_mask_otg_irqs(hsotg);	/* re-mask after core_init */
+		/* dwc2_hcd_start -> start_work -> dwc2_host_start ->
+		 * _dwc2_hcd_start -> dwc2_vbus_supply_init(): VBUS_EN high. */
+		dwc2_hcd_start(hsotg);
+	} else {
+		/* Stop sourcing VBUS *before* dropping out of host, then tear
+		 * the host controller down to idle. */
+		dwc2_vbus_supply_exit(hsotg);	/* VBUS_EN low */
+		dwc2_hcd_stop(hsotg);
+
+		hsotg->op_state = OTG_STATE_B_PERIPHERAL;
+		dwc2_core_init(hsotg, false);
+		dwc2_enable_global_interrupts(hsotg);
+		dwc2_role_mask_otg_irqs(hsotg);	/* re-mask after core_init */
+		spin_lock_irqsave(&hsotg->lock, flags);
+		dwc2_hsotg_core_init_disconnected(hsotg, false);
+		spin_unlock_irqrestore(&hsotg->lock, flags);
+		dwc2_enable_acg(hsotg);
+		dwc2_hsotg_core_connect(hsotg);	/* clear SFTDISCON -> D+ pullup */
+	}
+
+out:
+	mutex_unlock(&hsotg->init_mutex);
+	return 0;
+}
+
+/* ---- sysfs: /sys/devices/.../4340000.usb/dwc2_role ---- */
+static ssize_t dwc2_role_show(struct device *dev,
+			      struct device_attribute *attr, char *buf)
+{
+	struct dwc2_hsotg *hsotg = dev_get_drvdata(dev);
+
+	return sysfs_emit(buf, "%s\n",
+			  dwc2_is_host_mode(hsotg) ? "host" : "device");
+}
+
+static ssize_t dwc2_role_store(struct device *dev,
+			       struct device_attribute *attr,
+			       const char *buf, size_t count)
+{
+	struct dwc2_hsotg *hsotg = dev_get_drvdata(dev);
+	bool host;
+	int ret;
+
+	if (sysfs_streq(buf, "host") || sysfs_streq(buf, "1"))
+		host = true;
+	else if (sysfs_streq(buf, "device") || sysfs_streq(buf, "peripheral") ||
+		 sysfs_streq(buf, "0"))
+		host = false;
+	else
+		return -EINVAL;
+
+	ret = dwc2_switch_role(hsotg, host);
+	return ret ? ret : count;
+}
+static DEVICE_ATTR_RW(dwc2_role);
+
+/*
+ * TODO(verify): dev_get_drvdata(dev) must return the struct dwc2_hsotg*.
+ * dwc2_driver_probe() does platform_set_drvdata(dev, hsotg), so on the
+ * platform device this holds; confirm for the 7.2.4 probe.
+ */
+
 /* TODO(verify): create/remove the attribute at hcd init/teardown. The two
  * hunks below anchor on dwc2_hcd_init()'s success tail and
  * dwc2_hcd_remove()'s entry; confirm the surrounding lines. */
@@ -5000,6 +5171,9 @@ int dwc2_hcd_init(struct dwc2_hsotg *hsotg)
 	if (retval)
 		goto error4;

+	if (hsotg->manual_role &&
+	    device_create_file(hsotg->dev, &dev_attr_dwc2_role))
+		dev_warn(hsotg->dev, "dwc2_role: could not create sysfs attr\n");
+
 	dwc2_hcd_dump_state(hsotg);

 	dwc2_dbg_hcd_init(hsotg);
@@ -5040,6 +5214,9 @@ void dwc2_hcd_remove(struct dwc2_hsotg *hsotg)
 {
 	struct usb_hcd *hcd;

+	if (hsotg->manual_role)
+		device_remove_file(hsotg->dev, &dev_attr_dwc2_role);
+
 	hcd = dwc2_hsotg_to_hcd(hsotg);
