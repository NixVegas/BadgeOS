# Uptime as an analog watch face: a minute track, hour ticks and hands. draw.nix has no
# diagonal primitive, so the hands use a DDA line (`lineE`). The sine table sits above
# `scope:` so it is built once, not per frame (see effects/README.md).
#
#   32px (r=15 dial on the right, 3 text rows left):
#   UPTIME                 .-'-.
#   1d 01:01:01           (  |  )     <- hour + minute hands, second PIP
#   L 0.42  B 87%          `-.-'
#
#   64px (r=30 dial on the right, 4 text rows left):
#   UPTIME                  . ' .
#                         .   |   .
#   01:01:01              .   +---.   <- hour, minute AND second hands
#                         .       .
#   DAY 1                   . _ .
#   LOAD 0.42
#
#   scope: { t; width; height; uptimeS; load1; batteryPct; ... }
#   -> { bitmap = [ width*height/8/4 ints ]; nextMs; }
let
  # round(1000 * sin(2*pi*k/60)), k = 0..59 clockwise from 12 o'clock, generated by:
  #   awk 'BEGIN{pi=atan2(0,-1);for(k=0;k<60;k++)printf "%d ", \
  #        (sin(2*pi*k/60)<0 ? -int(-1000*sin(2*pi*k/60)+0.5) : int(1000*sin(2*pi*k/60)+0.5))}'
  sinTab = [
    0
    105
    208
    309
    407
    500
    588
    669
    743
    809
    866
    914
    951
    978
    995
    1000
    995
    978
    951
    914
    866
    809
    743
    669
    588
    500
    407
    309
    208
    105
    0
    (-105)
    (-208)
    (-309)
    (-407)
    (-500)
    (-588)
    (-669)
    (-743)
    (-809)
    (-866)
    (-914)
    (-951)
    (-978)
    (-995)
    (-1000)
    (-995)
    (-978)
    (-951)
    (-914)
    (-866)
    (-809)
    (-743)
    (-669)
    (-588)
    (-500)
    (-407)
    (-309)
    (-208)
    (-105)
  ];
in
scope:
let
  d = (import ./draw.nix) { inherit (scope) width height; };
  inherit (d) width height;
  sp = d.spleen5x8;

  # k >= 0 only: d.mod truncates, so a negative k gives a negative index.
  sinAt = k: builtins.elemAt sinTab (d.mod k 60);
  cosAt = k: sinAt (k + 15);

  s = scope.uptimeS;
  days = s / 86400;
  hh = (d.mod s 86400) / 3600;
  mm = (d.mod s 3600) / 60;
  ss = d.mod s 60;
  timeStr = "${d.pad2 hh}:${d.pad2 mm}:${d.pad2 ss}";
  # The hour hand advances within the hour, as on a real watch.
  kHour = (d.mod hh 12) * 5 + mm / 12;

  load1x100 = builtins.floor (scope.load1 * 100.0);
  ldStr = "${toString (load1x100 / 100)}.${d.pad2 (d.mod load1x100 100)}";
  bat = if scope.batteryPct > 100 then 100 else scope.batteryPct;

  cx = if height >= 64 then 96 else 110;
  cy = if height >= 64 then 32 else 16;
  rDial = if height >= 64 then 30 else 15;

  px = r: k: cx + (r * (sinAt k)) / 1000;
  py = r: k: cy - (r * (cosAt k)) / 1000;

  # A gapless DDA line as one entry list.
  lineE =
    x0: y0: x1: y1:
    let
      dx = x1 - x0;
      dy = y1 - y0;
      adx = if dx < 0 then -dx else dx;
      ady = if dy < 0 then -dy else dy;
      n = if adx > ady then adx else ady;
    in
    if n == 0 then
      d.setPixel d.empty x0 y0
    else
      builtins.concatLists (
        builtins.genList (i: d.setPixel d.empty (x0 + (dx * i) / n) (y0 + (dy * i) / n)) (n + 1)
      );

  # A hand from the hub out to radius r at dial position k.
  handE = r: k: lineE cx cy (px r k) (py r k);

  # The minute track: 60 single pixels.
  rimE = builtins.concatLists (builtins.genList (k: d.setPixel d.empty (px rDial k) (py rDial k)) 60);

  # Twelve hour ticks on the big face, four on the small one.
  tickKs =
    if height >= 64 then
      builtins.genList (j: j * 5) 12
    else
      [
        0
        15
        30
        45
      ];
  tickIn = if height >= 64 then 5 else 4;
  ticksE = builtins.concatLists (
    map (
      k: lineE (px (rDial - tickIn) k) (py (rDial - tickIn) k) (px (rDial - 1) k) (py (rDial - 1) k)
    ) tickKs
  );

  hubE = d.fillRect d.empty (cx - 1) (cy - 1) 3 3;

  # Three hands inside a 15 px radius are mush, so the seconds are a pip on the rim.
  layout32 =
    let
      face = rimE ++ ticksE ++ handE 7 kHour ++ handE 12 mm ++ hubE;
      pip = d.fillRect d.empty (px (rDial - 2) ss) (py (rDial - 2) ss) 2 2;
      upStr = if days > 0 then "${toString days}d ${timeStr}" else timeStr;
      s0 = sp.drawText (face ++ pip) 1 2 "UPTIME";
      s1 = sp.drawText s0 1 12 upStr;
      s2 = sp.drawText s1 1 22 "L ${ldStr}  B ${toString bat}%";
    in
    d.pack s2;

  layout64 =
    let
      face = rimE ++ ticksE ++ handE 16 kHour ++ handE 24 mm ++ handE 27 ss ++ hubE;
      s0 = sp.drawText face 2 8 "UPTIME";
      s1 = sp.drawText s0 2 22 timeStr;
      s2 = sp.drawText s1 2 36 "DAY ${toString days}";
      s3 = sp.drawText s2 2 50 "LOAD ${ldStr}";
    in
    d.pack s3;
in
{
  bitmap = if height >= 64 then layout64 else layout32;
  # uptimeS has one-second resolution.
  nextMs = 1000;
}
