+/// PRIVATE|ANONYMOUS|NORESERVE flags for the big self-managed reservations.
+/// Zig's `std.posix.MAP` names `NORESERVE` on x86_64/aarch64 but not on
+/// riscv64 (its layout leaves bit 14 in an anonymous padding field), so we set
+/// the field where it exists and OR in the numeric bit otherwise. Both paths
+/// produce the identical `MAP_NORESERVE = 0x4000` bit — a NORESERVE mapping
+/// only costs physical pages as they are touched. Byte-identical to the old
+/// literal on x86_64/aarch64.
+const private_anon_noreserve: std.posix.MAP = blk: {
+    const base: std.posix.MAP = .{ .TYPE = .PRIVATE, .ANONYMOUS = true };
+    if (@hasField(std.posix.MAP, "NORESERVE")) {
+        var m = base;
+        m.NORESERVE = true;
+        break :blk m;
+    }
+    // MAP_NORESERVE == 0x4000 (asm-generic/mman.h; bit 14). riscv64 uses the
+    // generic ABI value, matching x86_64/aarch64's NORESERVE bit position.
+    break :blk @bitCast(@as(u32, @bitCast(base)) | 0x4000);
+};
