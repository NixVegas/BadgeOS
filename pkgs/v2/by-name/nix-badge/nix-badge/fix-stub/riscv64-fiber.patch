diff --git a/src/base/hugetlb.zig b/src/base/hugetlb.zig
index 04055dd..4f17d0d 100644
--- a/src/base/hugetlb.zig
+++ b/src/base/hugetlb.zig
@@ -23,6 +23,24 @@ pub const huge_page_size: usize = 2 << 20;
 // Linux 5.14+. Zig's std.os.linux.MADV does not expose this newer value yet.
 const madv_populate_write: u32 = 23;
 
+/// PRIVATE|ANONYMOUS|NORESERVE|FIXED for re-asserting a mapping over a target.
+/// Zig's `std.posix.MAP` names `NORESERVE` on x86_64/aarch64 but not on riscv64
+/// (its layout leaves bit 14 in an anonymous padding field), so we set the
+/// named fields and OR in the numeric NORESERVE bit where it has no name. Both
+/// paths produce `MAP_NORESERVE = 0x4000`. Byte-identical to the old literal on
+/// x86_64/aarch64.
+const private_anon_noreserve_fixed: std.posix.MAP = blk: {
+    const base: std.posix.MAP = .{ .TYPE = .PRIVATE, .ANONYMOUS = true, .FIXED = true };
+    if (@hasField(std.posix.MAP, "NORESERVE")) {
+        var m = base;
+        m.NORESERVE = true;
+        break :blk m;
+    }
+    // MAP_NORESERVE == 0x4000 (asm-generic/mman.h; bit 14). riscv64 uses the
+    // generic ABI value, matching x86_64/aarch64's NORESERVE bit position.
+    break :blk @bitCast(@as(u32, @bitCast(base)) | 0x4000);
+};
