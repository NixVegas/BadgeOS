scaler: let the DSI host turn the EoT packet off

sclr_dsi_config() writes only the format and lane bits of REG_SCL_DSI_HS_0,
so the EoT bit (26) keeps whatever the bootloader left. Add a helper that
sets just that bit.

Signed-off-by: badgeos
---
--- a/interdrv/vpss/chip/cv181x/scaler.c
+++ b/interdrv/vpss/chip/cv181x/scaler.c
@@ -4238,6 +4238,13 @@
 }
 EXPORT_SYMBOL_GPL(sclr_dsi_config);
 
+/* The EoT packet after each HS transmission; the rest of HS_0 is left alone. */
+void sclr_dsi_set_eot(bool on)
+{
+	_reg_write_mask(reg_base + REG_SCL_DSI_HS_0, BIT(26), on ? BIT(26) : 0);
+}
+EXPORT_SYMBOL_GPL(sclr_dsi_set_eot);
+
 #ifdef __CV181X__
 void i80_set_cmd0(u32 cmd)
 {
--- a/interdrv/vpss/chip/cv181x/scaler.h
+++ b/interdrv/vpss/chip/cv181x/scaler.h
@@ -1227,6 +1227,7 @@
 int sclr_dsi_dcs_write_buffer(u8 di, const void *data, size_t len, bool sw_mode);
 int sclr_dsi_dcs_read_buffer(u8 di, const u16 data_param, u8 *data, size_t len);
 int sclr_dsi_config(u8 lane_num, enum sclr_dsi_fmt fmt, u16 width);
+void sclr_dsi_set_eot(bool on);
 void sclr_i80_sw_mode(bool enable);
 void sclr_i80_packet(u32 cmd);
 void sclr_i80_run(void);
