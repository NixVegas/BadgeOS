+/*
+ * Stop and join the channel's bind-mode event handler kthread, if one is
+ * running.
+ *
+ * vdec_event_handler() sleeps in down_timeout() on pChnHandle->sem_getframe,
+ * a struct semaphore embedded in the channel context, and CVI_VDEC_DestroyChn()
+ * vfree()s that context.  The thread therefore has to be *gone* -- joined, not
+ * merely asked to stop -- before the free, or it wakes up on a page that is no
+ * longer mapped:
+ *
+ *   Unable to handle kernel paging request at virtual address ffff800084b7d620
+ *     _raw_spin_lock_irq / __down_timeout / down_timeout
+ *     vdec_event_handler+0x12c/0x3c0 [cvi_vc_driver]
+ *   note: cvitask_vdec_0 exited with irqs disabled
+ *
+ * It faults inside the semaphore's own spinlock with interrupts off, so the
+ * thread never comes back and the machine stays degraded until it is rebooted.
+ *
+ * Safe to call when no thread was ever started, and safe to call twice.
+ */
+static void _cvi_vdec_stop_event_handler(vdec_chn_context *pChnHandle)
+{
+	struct cvi_vdec_vb_ctx *pVbCtx = pChnHandle->pVbCtx;
+	struct task_struct *thread;
+
+	if (pVbCtx == NULL)
+		return;
+
+	/*
+	 * Claim the thread first: a second destroy must not join it twice, and
+	 * CVI_VDEC_SendStream() must not adopt it again.
+	 */
+	thread = pVbCtx->thread;
+	pVbCtx->thread = NULL;
+
+	if (thread == NULL || IS_ERR(thread)) {
+		pVbCtx->currBindMode = CVI_FALSE;
+		return;
+	}
+
+	CVI_VDEC_INFO("stopping vdec thread for chn %d\n", pChnHandle->VdChn);
+
+	/*
+	 * Release a handler that is blocked right now, then ask it to stop and
+	 * wait for it to return.  The up() is not enough on its own and neither
+	 * is kthread_stop(): down_timeout() sleeps in TASK_UNINTERRUPTIBLE, so
+	 * kthread_stop()'s wakeup does not abort the wait.  The join is thus
+	 * bounded by that wait's one-second timeout, after which the handler
+	 * sees kthread_should_stop() and unwinds.
+	 */
+	SEMA_POST(&pChnHandle->sem_getframe);
+	kthread_stop(thread);
+
+	pVbCtx->currBindMode = CVI_FALSE;
+
+	CVI_VDEC_INFO("vdec thread stopped for chn %d\n", pChnHandle->VdChn);
+}
