+/*
+ * Masks the line if the receiver ever interrupts at a rate no sensor can
+ * produce; see the same guard in the vi driver for why a storm is fatal here.
+ * One sensor runs at a time, so one window is enough.
+ */
+static unsigned int cif_irq_rate_max = 2000;
+module_param(cif_irq_rate_max, uint, 0644);
+
+static u64 cif_irq_window_start;
+static unsigned int cif_irq_window_cnt;
+static bool cif_irq_masked;
+
 static irqreturn_t cif_isr(int irq, void *_link)
 {
 	struct cvi_link *link = (struct cvi_link *)_link;
 	struct cif_ctx *ctx = &link->cif_ctx;
+	u64 now = sched_clock();
+
+	if (now - cif_irq_window_start > 100000000ULL) {
+		cif_irq_window_start = now;
+		cif_irq_window_cnt = 0;
+	}
+
+	if (++cif_irq_window_cnt > cif_irq_rate_max) {
+		if (!cif_irq_masked) {
+			cif_irq_masked = true;
+			disable_irq_nosync(irq);
+			dev_err(link->dev, "interrupt storm, masking irq %d\n", irq);
+		}
+		return IRQ_HANDLED;
+	}
 
 	if (cif_check_csi_int_sts(ctx, CIF_INT_STS_ECC_ERR_MASK))
 		link->sts_csi.errcnt_ecc++;

