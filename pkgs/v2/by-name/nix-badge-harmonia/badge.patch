+            tokio::spawn(async move { fetch(&registry, &metrics, &cfg, &path).await })
+        };
+        tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+        fetch(&registry, &metrics, &cfg, &fx.r).await;
+        fetch(&registry, &metrics, &cfg, &fx.r2).await;
+        // The body ends with the last chunk, a moment before the job marks itself produced.
+        tokio::time::sleep(std::time::Duration::from_millis(300)).await;
+        let app = actix_web::test::init_service(
+            actix_web::App::new()
+                .app_data(cfg.clone())
+                .app_data(web::Data::new(registry.clone()))
+                .app_data(metrics.clone())
+                .route("/nar/{narhash}.nar", web::get().to(crate::nar::get)),
+        )
+        .await;
+        let req = actix_web::test::TestRequest::get()
+            .uri(&format!("/nar/{}.nar?hash={}", "0".repeat(52), RefFixture::hash_of(&fx.r2)))
+            .to_request();
+        let started = std::time::Instant::now();
+        let resp = tokio::time::timeout(
+            std::time::Duration::from_secs(4),
+            actix_web::test::call_service(&app, req),
+        )
+        .await
+        .expect("the late request waited for the import queue");
+        assert_eq!(resp.status(), actix_web::http::StatusCode::NOT_FOUND);
+        assert!(started.elapsed() < std::time::Duration::from_secs(3), "the miss took {:?}", started.elapsed());
+        s.abort();
+    }
+
+    #[tokio::test]
+    async fn a_job_without_a_slot_fails_fast() {
+        // One slot, held by Q's stream; R gets none in time and is a miss.
+        let fx = make_ref_fixture(false).await;
+        let (upstream, _, r_gets) = fx.upstream((3000, 0)).await;
+        let mut cfg = fx.settings(vec![upstream], 1);
+        cfg.miss_slot_wait_secs = 1;
+        let cfg = web::Data::new(cfg);
+        let (registry, metrics) = registry(1);
+        let q = {
+            let (registry, metrics, cfg, path) = (registry.clone(), metrics.clone(), cfg.clone(), fx.q.clone());
+            tokio::spawn(async move { fetch(&registry, &metrics, &cfg, &path).await })
+        };
+        tokio::time::sleep(std::time::Duration::from_millis(200)).await;
+        let started = std::time::Instant::now();
+        let r = tokio::time::timeout(
+            std::time::Duration::from_secs(4),
+            registry.attach(cfg.clone(), metrics.clone(), &RefFixture::hash_of(&fx.r)),
+        )
+        .await
+        .expect("R waited for a slot past miss_slot_wait_secs");
+        match r {
+            Attach::Parked(done) => assert_eq!(*done.borrow(), JobState::Failed, "R's job did not fail"),
+            Attach::Live(_) => panic!("R got a stream although no slot was free"),
+        }
+        let waited = started.elapsed();
+        assert!(
+            waited >= std::time::Duration::from_millis(900) && waited < std::time::Duration::from_secs(3),
+            "R failed after {waited:?}, not after the 1 s slot wait"
+        );
+        q.await.unwrap();
+        tokio::time::sleep(std::time::Duration::from_millis(500)).await;
+        assert_eq!(r_gets.load(Ordering::SeqCst), 0, "R's NAR was fetched for a failed job");
+    }
+
+    #[tokio::test]
+    async fn a_refused_upstream_is_asked_again() {
+        // A refused connection costs no time, so unlike a timeout it takes no upstream
+        // out: an upstream back from a restart serves the next miss.
+        let fx = make_ref_fixture(false).await;
+        let port = TcpListener::bind("127.0.0.1:0").await.unwrap().local_addr().unwrap().port();
+        let (second, _) = fx.serve(&[(fx.q.as_str(), 0), (fx.r.as_str(), 0)]).await;
+        let cfg = web::Data::new(fx.settings(vec![format!("http://127.0.0.1:{port}"), second], 8));
+        let (registry, metrics) = registry(8);
+        fetch(&registry, &metrics, &cfg, &fx.q).await;
+        let (_, first) = fx
+            .serve_at(&format!("127.0.0.1:{port}"), &[(fx.q.as_str(), 0), (fx.r.as_str(), 0)])
+            .await;
+        fetch(&registry, &metrics, &cfg, &fx.r).await;
+        assert_eq!(
+            first[1].gets.load(Ordering::SeqCst),
+            1,
+            "the first upstream was skipped after it refused a connection"
+        );
+    }
+
+    #[tokio::test]
+    async fn a_down_upstream_is_skipped() {
+        let fx = make_ref_fixture(false).await;
+        let (silent, silent_hits) = spawn_silent_upstream().await;
+        let (upstream, _, r_gets) = fx.upstream((0, 0)).await;
+        let mut cfg = fx.settings(vec![silent, upstream], 8);
+        cfg.miss_read_timeout_secs = 1;
+        let cfg = web::Data::new(cfg);
+        let (registry, metrics) = registry(8);
+        // The first miss waits out the silent upstream's read timeout.
+        fetch(&registry, &metrics, &cfg, &fx.q).await;
+        assert_eq!(silent_hits.load(Ordering::SeqCst), 1);
+        let started = std::time::Instant::now();
+        fetch(&registry, &metrics, &cfg, &fx.r).await;
+        let took = started.elapsed();
+        assert_eq!(silent_hits.load(Ordering::SeqCst), 1, "the down upstream was asked again");
+        assert!(took < std::time::Duration::from_secs(1), "the second miss took {took:?}");
+        assert_eq!(r_gets.load(Ordering::SeqCst), 1, "R's NAR didn't come from the second upstream");
+    }
 }
