+    /// An upstream with nothing on it: 404 for every request, counting them.
+    async fn spawn_missing_upstream() -> (String, Arc<AtomicUsize>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let counter = Arc::new(AtomicUsize::new(0));
+        let counter_task = counter.clone();
+        tokio::spawn(async move {
+            while let Ok((mut sock, _)) = listener.accept().await {
+                let counter = counter_task.clone();
+                tokio::spawn(async move {
+                    let mut buf = vec![0u8; 4096];
+                    if matches!(sock.read(&mut buf).await, Ok(n) if n > 0) {
+                        counter.fetch_add(1, Ordering::SeqCst);
+                        let _ = sock
+                            .write_all(
+                                b"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
+                            )
+                            .await;
+                    }
+                });
+            }
+        });
+        (format!("http://{addr}"), counter)
+    }
