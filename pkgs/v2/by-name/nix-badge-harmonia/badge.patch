+
+        /// An upstream serving Q and R from the fixture's cache, holding each
+        /// path's NAR response for its delay; counts NAR GETs per path.
+        async fn upstream(&self, delays_ms: (u64, u64)) -> (String, Arc<AtomicUsize>, Arc<AtomicUsize>) {
+            let (url, hits) = self.serve(&[(self.q.as_str(), delays_ms.0), (self.r.as_str(), delays_ms.1)]).await;
+            (url, hits[0].gets.clone(), hits[1].gets.clone())
+        }
+
+        /// An upstream serving `paths` from the fixture's cache, holding each
+        /// path's NAR response for its delay.
+        async fn serve(&self, paths: &[(&str, u64)]) -> (String, Vec<NarHits>) {
+            self.serve_at("127.0.0.1:0", paths).await
+        }
+
+        /// [`Self::serve`] on the address `at`.
+        async fn serve_at(&self, at: &str, paths: &[(&str, u64)]) -> (String, Vec<NarHits>) {
+            let hits: Vec<NarHits> = paths.iter().map(|_| NarHits::default()).collect();
+            let paths: Vec<_> = paths
+                .iter()
+                .zip(&hits)
+                .map(|((path, delay), hits)| {
+                    let (url, bytes) = self.nar(path);
+                    (Self::hash_of(path), self.narinfo(path), url, bytes, *delay, hits.clone())
+                })
+                .collect();
+            let paths = Arc::new(paths);
+            let listener = TcpListener::bind(at).await.unwrap();
+            let addr = listener.local_addr().unwrap();
+            tokio::spawn(async move {
+                while let Ok((mut sock, _)) = listener.accept().await {
+                    let paths = paths.clone();
+                    tokio::spawn(async move {
+                        let mut buf = vec![0u8; 4096];
+                        let n = match sock.read(&mut buf).await {
+                            Ok(0) | Err(_) => return,
+                            Ok(n) => n,
+                        };
+                        let req = String::from_utf8_lossy(&buf[..n]).to_string();
+                        let path = req.lines().next().and_then(|l| l.split_whitespace().nth(1)).unwrap_or("/");
+                        let path = path.trim_start_matches('/');
+                        for (hash, narinfo, url, bytes, delay, hits) in paths.iter() {
+                            let body: &[u8] = if path == format!("{hash}.narinfo") {
+                                narinfo.as_bytes()
+                            } else if path == url {
+                                hits.gets.fetch_add(1, Ordering::SeqCst);
+                                tokio::time::sleep(std::time::Duration::from_millis(*delay)).await;
+                                hits.sent.lock().unwrap().push(std::time::Instant::now());
+                                bytes
+                            } else {
+                                continue;
+                            };
+                            let head = format!(
+                                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                                body.len()
+                            );
+                            let _ = sock.write_all(head.as_bytes()).await;
+                            let _ = sock.write_all(body).await;
+                            return;
+                        }
+                        let _ = sock
+                            .write_all(b"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                            .await;
+                    });
+                }
+            });
+            (format!("http://{addr}"), hits)
+        }
+    }
