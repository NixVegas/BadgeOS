+    /// An upstream that accepts connections and never answers; counts the connections.
+    async fn spawn_silent_upstream() -> (String, Arc<AtomicUsize>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let counter = Arc::new(AtomicUsize::new(0));
+        let counter_task = counter.clone();
+        tokio::spawn(async move {
+            let mut held = Vec::new();
+            while let Ok((sock, _)) = listener.accept().await {
+                counter_task.fetch_add(1, Ordering::SeqCst);
+                held.push(sock);
+            }
+        });
+        (format!("http://{addr}"), counter)
+    }
