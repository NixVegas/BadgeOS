+    /// Serves the narinfo, but stalls the first NAR request halfway (headers and
+    /// half the body, then silence); later NAR requests get it whole.
+    async fn spawn_stalling_upstream(
+        narinfo_text: String,
+        nar_xz: Vec<u8>,
+    ) -> (String, Arc<AtomicUsize>) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let counter = Arc::new(AtomicUsize::new(0));
+        let counter_task = counter.clone();
+        tokio::spawn(async move {
+            let mut held = Vec::new();
+            while let Ok((mut sock, _)) = listener.accept().await {
+                let mut buf = vec![0u8; 4096];
+                let n = match sock.read(&mut buf).await {
+                    Ok(0) | Err(_) => continue,
+                    Ok(n) => n,
+                };
+                let req = String::from_utf8_lossy(&buf[..n]).to_string();
+                let path = req
+                    .lines()
+                    .next()
+                    .and_then(|l| l.split_whitespace().nth(1))
+                    .unwrap_or("/")
+                    .to_string();
+                if path.ends_with(".narinfo") {
+                    let head = format!(
+                        "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nContent-Type: text/x-nix-narinfo\r\nConnection: close\r\n\r\n",
+                        narinfo_text.len()
+                    );
+                    let _ = sock.write_all(head.as_bytes()).await;
+                    let _ = sock.write_all(narinfo_text.as_bytes()).await;
+                    continue;
+                }
+                let head = format!(
+                    "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nContent-Type: application/x-xz\r\nConnection: close\r\n\r\n",
+                    nar_xz.len()
+                );
+                let _ = sock.write_all(head.as_bytes()).await;
+                if counter_task.fetch_add(1, Ordering::SeqCst) == 0 {
+                    let _ = sock.write_all(&nar_xz[..nar_xz.len() / 2]).await;
+                    held.push(sock);
+                } else {
+                    let _ = sock.write_all(&nar_xz).await;
+                }
+            }
+        });
+        (format!("http://{addr}"), counter)
+    }
