+    /// Serve `dir` as a binary cache over HTTP, logging each request's path and time.
+    async fn serve_cache(dir: PathBuf) -> (String, RequestLog) {
+        let listener = TcpListener::bind("127.0.0.1:0").await.unwrap();
+        let addr = listener.local_addr().unwrap();
+        let log: RequestLog = Arc::default();
+        let log_task = log.clone();
+        tokio::spawn(async move {
+            while let Ok((mut sock, _)) = listener.accept().await {
+                let (dir, log) = (dir.clone(), log_task.clone());
+                tokio::spawn(async move {
+                    let mut buf = vec![0u8; 4096];
+                    let n = match sock.read(&mut buf).await {
+                        Ok(0) | Err(_) => return,
+                        Ok(n) => n,
+                    };
+                    let req = String::from_utf8_lossy(&buf[..n]).to_string();
+                    let mut first = req.lines().next().unwrap_or("").split_whitespace();
+                    let method = first.next().unwrap_or("GET").to_string();
+                    let path = first.next().unwrap_or("/").trim_start_matches('/').to_string();
+                    log.lock().unwrap().push((path.clone(), std::time::Instant::now()));
+                    match std::fs::read(dir.join(&path)) {
+                        Ok(body) if !path.is_empty() && !path.contains("..") => {
+                            let head = format!(
+                                "HTTP/1.1 200 OK\r\nContent-Length: {}\r\nConnection: close\r\n\r\n",
+                                body.len()
+                            );
+                            let _ = sock.write_all(head.as_bytes()).await;
+                            if method != "HEAD" {
+                                let _ = sock.write_all(&body).await;
+                            }
+                        }
+                        _ => {
+                            let _ = sock
+                                .write_all(b"HTTP/1.1 404 Not Found\r\nContent-Length: 0\r\nConnection: close\r\n\r\n")
+                                .await;
+                        }
+                    }
+                    let _ = sock.flush().await;
+                });
+            }
+        });
+        (format!("http://{addr}"), log)
+    }
+
+    /// A socket that forwards to the daemon's, counting the connections made to it.
+    async fn count_daemon_connections(daemon: &Path, dir: &Path) -> (PathBuf, Arc<AtomicUsize>) {
+        let proxy = dir.join("proxy.sock");
+        let listener = tokio::net::UnixListener::bind(&proxy).unwrap();
+        let counter = Arc::new(AtomicUsize::new(0));
+        let (counter_task, daemon) = (counter.clone(), daemon.to_path_buf());
+        tokio::spawn(async move {
+            while let Ok((mut client, _)) = listener.accept().await {
+                counter_task.fetch_add(1, Ordering::SeqCst);
+                let daemon = daemon.clone();
+                tokio::spawn(async move {
+                    if let Ok(mut d) = tokio::net::UnixStream::connect(&daemon).await {
+                        let _ = tokio::io::copy_bidirectional(&mut client, &mut d).await;
+                    }
+                });
+            }
+        });
+        (proxy, counter)
+    }
+
+    /// NAR GETs of one path on a fake upstream, and when each began to be answered.
+    #[derive(Clone, Default)]
+    struct NarHits {
+        gets: Arc<AtomicUsize>,
+        sent: Arc<std::sync::Mutex<Vec<std::time::Instant>>>,
+    }
+
+    impl RefFixture {
+        fn hash_of(path: &str) -> String {
