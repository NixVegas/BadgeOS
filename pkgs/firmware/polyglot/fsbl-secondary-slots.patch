+	return 0;
+#endif
+
 	NOTICE("C2S/0x%x/0x%x/0x%x.\n", fip_param2.blcp_2nd_loadaddr, fip_param2.blcp_2nd_runaddr,
 	       fip_param2.blcp_2nd_size);
 
@@ -260,6 +267,17 @@
 	uint32_t crc;
 	int ret = -1;
 
+#ifdef POLYGLOT_SECONDARY
+	/* Polyglot fip (#48): the secondary core's MONITOR rides the BLCP_2ND
+	 * slot (its RUNADDR is set to a DRAM monitor address, e.g. 0x80000000).
+	 * Alias the BLCP_2ND fields into monitor_* so the rest of this function
+	 * loads + verifies + enters it unchanged. load_blcp_2nd() is neutered. */
+	fip_param2.monitor_loadaddr = fip_param2.blcp_2nd_loadaddr;
+	fip_param2.monitor_runaddr  = fip_param2.blcp_2nd_runaddr;
+	fip_param2.monitor_size     = fip_param2.blcp_2nd_size;
+	fip_param2.monitor_cksum    = fip_param2.blcp_2nd_cksum;
+#endif
+
 	NOTICE("MS/0x%x/0x%x/0x%x.\n", fip_param2.monitor_loadaddr, fip_param2.monitor_runaddr,
 	       fip_param2.monitor_size);
 
@@ -368,6 +386,14 @@
 	int reading_size;
 	void *image_buf;
 
+#ifdef POLYGLOT_SECONDARY
+	/* Polyglot fip (#48): the secondary core's u-boot rides the LOADER_2ND_B
+	 * slot, packed symmetrically (loader_2nd_header + LZMA) by fiptool. Alias
+	 * its loadaddr into loader_2nd_loadaddr so the header parse + decompress +
