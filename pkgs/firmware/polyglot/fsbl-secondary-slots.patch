+# Polyglot fip (#48): applied ONLY to the secondary-core FSBL (fsbl.nix
+# slot="secondary"), so define unconditionally. Makes load_monitor /
+# load_loader_2nd read the spare BLCP_2ND / LOADER_2ND_B slots and neuters
+# load_blcp_2nd (see the bl2_opt.c hunks in this same patch).
+$(eval $(call add_define,POLYGLOT_SECONDARY))
 $(eval $(call add_define,NANDBOOT_V2))
 
